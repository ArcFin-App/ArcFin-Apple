    "Connect AirPods or other Bluetooth headphones to play music on your watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde AirPods oder andere Bluetooth-Kopfhörer, um Musik auf deiner Uhr zu hören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta unos AirPods u otros auriculares Bluetooth para escuchar música en el reloj."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez des AirPods ou d’autres écouteurs Bluetooth pour écouter de la musique sur votre montre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega AirPods o altre cuffie Bluetooth per ascoltare musica sull’orologio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchで音楽を再生するには、AirPodsなどのBluetoothヘッドフォンを接続してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "워치에서 음악을 재생하려면 AirPods 또는 다른 Bluetooth 헤드폰을 연결하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind AirPods of andere bluetoothkoptelefoons om muziek op je horloge af te spelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte AirPods ou outros fones Bluetooth para ouvir música no relógio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите AirPods или другие Bluetooth-наушники, чтобы слушать музыку на часах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 AirPods 或其他蓝牙耳机，即可在手表上播放音乐。"
          }
        }
      }
    },
