    "Open Arcfin on your iPhone and sign in to use the remote." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Arcfin auf deinem iPhone und melde dich an, um die Fernbedienung zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Arcfin en tu iPhone e inicia sesión para usar el mando."
