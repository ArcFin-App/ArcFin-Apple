    "A video is playing. Downloading now shares its connection, which can lower its quality." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Video wird abgespielt. Ein Download jetzt teilt sich die Verbindung und kann die Qualität senken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se está reproduciendo un vídeo. Descargar ahora comparte su conexión y puede reducir su calidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une vidéo est en cours de lecture. Télécharger maintenant partage sa connexion et peut réduire sa qualité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "È in riproduzione un video. Scaricare ora ne condivide la connessione e può ridurne la qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ビデオを再生中です。今ダウンロードすると回線を分け合うため、画質が下がることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "동영상을 재생하는 중입니다. 지금 다운로드하면 연결을 나눠 써서 화질이 낮아질 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er speelt een video. Nu downloaden deelt de verbinding en kan de kwaliteit verlagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um vídeo está sendo reproduzido. Baixar agora divide a conexão e pode reduzir a qualidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Идёт воспроизведение видео. Загрузка сейчас разделит соединение и может снизить качество."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
