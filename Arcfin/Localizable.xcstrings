        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再起動後、このデバイスがサーバに接続できなくなる可能性があります：Arcfin は %@ に接続しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
