    "The channel took too long to start. Its source may be slow or offline. Try again, or pick another channel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Sender hat zu lange zum Starten gebraucht. Seine Quelle ist vielleicht langsam oder offline. Versuche es erneut oder wähle einen anderen Sender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El canal tardó demasiado en empezar. Puede que su fuente sea lenta o esté desconectada. Inténtalo de nuevo o elige otro canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La chaîne a mis trop de temps à démarrer. Sa source est peut-être lente ou hors ligne. Réessayez ou choisissez une autre chaîne."
