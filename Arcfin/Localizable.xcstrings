            "value" : "Mitteilungen sind für Arcfin aus. Schalte sie in den Systemeinstellungen ein, um diese zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de Arcfin están desactivadas. Actívalas en Ajustes del Sistema para recibir estas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées pour Arcfin. Activez-les dans Réglages Système pour recevoir celles-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sono disattivate per Arcfin. Attivale in Impostazioni di Sistema per riceverle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfinの通知はオフです。これらを受け取るには「システム設定」でオンにしてください。"
