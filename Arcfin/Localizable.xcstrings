    "Arcfin has a new coral colour and a new app icon, in light and dark appearance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin hat eine neue Korallenfarbe und ein neues App-Symbol, im hellen und im dunklen Erscheinungsbild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin tiene un nuevo color coral y un nuevo icono, en modo claro y oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin adopte une nouvelle couleur corail et une nouvelle icône, en apparence claire comme sombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin ha un nuovo colore corallo e una nuova icona, sia nell'aspetto chiaro sia in quello scuro."
