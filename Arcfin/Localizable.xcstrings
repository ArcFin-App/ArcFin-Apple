        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexão é lenta para vídeo HD. O servidor deve converter o vídeo para uma qualidade menor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это подключение медленное для HD-видео. Сервер, скорее всего, будет конвертировать видео в более низкое качество."
