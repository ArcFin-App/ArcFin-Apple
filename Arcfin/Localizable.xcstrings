          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los pósteres y fondos se guardan para cargar más rápido. Borrarlos nunca afecta a tus descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les affiches et arrière-plans sont conservés pour charger plus vite. Les effacer ne touche jamais vos téléchargements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Locandine e sfondi vengono conservati per caricare più in fretta. Svuotarli non tocca mai i tuoi download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ポスターと背景画像は読み込みを速くするために保存されます。消去してもダウンロードには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "포스터와 배경은 더 빨리 불러오기 위해 보관됩니다. 지워도 다운로드에는 영향이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Posters en achtergronden worden bewaard zodat ze sneller laden. Wissen raakt nooit je downloads."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pôsteres e fundos são guardados para carregar mais rápido. Limpá-los nunca afeta seus downloads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Постеры и фоны хранятся, чтобы быстрее загружаться. Очистка никогда не затрагивает ваши загрузки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "海报和背景图会被保留以加快加载速度。清除它们绝不会影响你的下载项。"
          }
        }
      }
    },
