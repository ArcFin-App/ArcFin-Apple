    "Choose Ignore in Smart Downloads in a movie or show's menu, or on it in Downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle „In Smart Downloads ignorieren“ im Menü eines Films oder einer Serie oder bei ihm in Downloads."
