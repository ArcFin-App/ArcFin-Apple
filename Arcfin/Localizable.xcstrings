    "Skip buttons show when your server knows where a recap, intro, credits or preview is, from the Intro Skipper, Chapter Segments Provider or SkipMe.db plugins." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sprungtasten erscheinen, wenn dein Server weiß, wo eine Rückblende, ein Intro, der Abspann oder eine Vorschau ist – über die Plugins Intro Skipper, Chapter Segments Provider oder SkipMe.db."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los botones de salto aparecen cuando tu servidor sabe dónde hay un resumen, una intro, los créditos o un avance, gracias a los complementos Intro Skipper, Chapter Segments Provider o SkipMe.db."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les boutons de saut apparaissent quand votre serveur sait où se trouve un résumé, un générique de début, de fin ou un aperçu, grâce aux plugins Intro Skipper, Chapter Segments Provider ou SkipMe.db."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I pulsanti di salto compaiono quando il server sa dove si trovano un riassunto, una sigla, i titoli di coda o un’anteprima, grazie ai plugin Intro Skipper, Chapter Segments Provider o SkipMe.db."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Intro Skipper、Chapter Segments Provider、SkipMe.dbのいずれかのプラグインによって、サーバがあらすじ、イントロ、エンドクレジット、予告の位置を把握している場合にスキップボタンが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "서버가 Intro Skipper, Chapter Segments Provider, SkipMe.db 플러그인을 통해 요약, 인트로, 크레딧, 미리보기의 위치를 알고 있으면 건너뛰기 버튼이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Springknoppen verschijnen als je server weet waar een samenvatting, intro, aftiteling of voorvertoning zit, via de plugins Intro Skipper, Chapter Segments Provider of SkipMe.db."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os botões de pular aparecem quando seu servidor sabe onde há uma recapitulação, abertura, créditos ou prévia, pelos plugins Intro Skipper, Chapter Segments Provider ou SkipMe.db."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Кнопки пропуска появляются, когда сервер знает, где находятся краткое содержание, заставка, титры или превью, благодаря плагинам Intro Skipper, Chapter Segments Provider или SkipMe.db."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当你的服务器通过 Intro Skipper、Chapter Segments Provider 或 SkipMe.db 插件知道回顾、片头、片尾或预告的位置时，会显示跳过按钮。"
          }
        }
      }
    },
