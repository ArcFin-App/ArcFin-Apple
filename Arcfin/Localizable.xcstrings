      }
    },
    "This Apple TV couldn't reach %@. Check it's on the same network as your server. If your server needs custom headers, add them here under Custom Headers first." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieses Apple TV konnte %@ nicht erreichen. Prüfe, ob es im selben Netzwerk wie dein Server ist. Braucht dein Server eigene Header, füge sie hier zuerst unter „Eigene Header“ hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este Apple TV no pudo conectar con %@. Comprueba que está en la misma red que tu servidor. Si tu servidor necesita encabezados personalizados, añádelos aquí primero en Encabezados personalizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette Apple TV n’a pas pu joindre %@. Vérifiez qu’elle est sur le même réseau que votre serveur. Si votre serveur a besoin d’en-têtes personnalisés, ajoutez-les d’abord ici dans En-têtes personnalisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa Apple TV non ha raggiunto %@. Controlla che sia sulla stessa rete del server. Se il server richiede intestazioni personalizzate, aggiungile prima qui in Intestazioni personalizzate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このApple TVから%@に接続できませんでした。サーバーと同じネットワークにあるか確認してください。サーバーにカスタムヘッダが必要な場合は、先にここの「カスタムヘッダ」で追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 Apple TV가 %@에 연결할 수 없습니다. 서버와 같은 네트워크에 있는지 확인하세요. 서버에 사용자 지정 헤더가 필요하면 먼저 여기의 사용자 지정 헤더에서 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deze Apple TV kon %@ niet bereiken. Controleer of hij op hetzelfde netwerk zit als je server. Heeft je server aangepaste headers nodig, voeg ze dan eerst hier toe onder Aangepaste headers."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta Apple TV não conseguiu acessar %@. Verifique se ela está na mesma rede do seu servidor. Se o servidor precisar de cabeçalhos personalizados, adicione-os primeiro aqui em Cabeçalhos personalizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Эта Apple TV не смогла связаться с %@. Убедитесь, что она в той же сети, что и сервер. Если серверу нужны собственные заголовки, сначала добавьте их здесь в разделе «Собственные заголовки»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这台 Apple TV 无法连接 %@。请确认它与服务器在同一网络中。如果服务器需要自定义标头，请先在此处的“自定义标头”中添加。"
          }
        }
      }
    },
    "This channel didn't send any video. Its source may be offline. Try again, or pick another channel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Sender hat kein Video gesendet. Seine Quelle ist vielleicht offline. Versuche es erneut oder wähle einen anderen Sender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este canal no envió vídeo. Puede que su fuente esté desconectada. Inténtalo de nuevo o elige otro canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette chaîne n'a envoyé aucune vidéo. Sa source est peut-être hors ligne. Réessayez ou choisissez une autre chaîne."
