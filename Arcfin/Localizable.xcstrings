    "Shazam couldn't name it. Try again closer to the music." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazam konnte ihn nicht erkennen. Versuche es näher an der Musik."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazam no pudo identificarla. Inténtalo más cerca de la música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazam n’a pas pu l’identifier. Réessayez plus près de la musique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazam non l’ha riconosciuto. Riprova più vicino alla musica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazamで曲名がわかりませんでした。音楽にもっと近づけてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazam이 노래를 찾지 못했습니다. 음악 가까이에서 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shazam kon het niet herkennen. Probeer het dichter bij de muziek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Shazam não conseguiu identificar. Tente mais perto da música."
          }
