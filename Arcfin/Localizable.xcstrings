    "Plays songs at about the same volume, using the loudness your server measured for each. Needs Jellyfin 10.9 or later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt Titel etwa gleich laut ab, anhand der Lautheit, die dein Server für jeden gemessen hat. Erfordert Jellyfin 10.9 oder neuer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce las canciones a un volumen parecido, según la sonoridad que tu servidor midió para cada una. Requiere Jellyfin 10.9 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit les morceaux à un volume similaire, selon l’intensité mesurée par votre serveur pour chacun. Nécessite Jellyfin 10.9 ou version ultérieure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce i brani a un volume simile, in base al volume che il server ha misurato per ciascuno. Richiede Jellyfin 10.9 o versioni successive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバが曲ごとに測定したラウドネスを使い、ほぼ同じ音量で再生します。Jellyfin 10.9以降が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 노래마다 측정한 음량을 사용해 비슷한 볼륨으로 재생합니다. Jellyfin 10.9 이상이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt nummers op ongeveer hetzelfde volume af, met de luidheid die je server per nummer heeft gemeten. Vereist Jellyfin 10.9 of nieuwer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz as músicas em volume parecido, usando a intensidade que seu servidor mediu para cada uma. Requer Jellyfin 10.9 ou posterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воспроизводит песни примерно с одинаковой громкостью по замерам вашего сервера. Нужен Jellyfin 10.9 или новее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据服务器为每首歌曲测得的响度，以大致相同的音量播放。需要 Jellyfin 10.9 或更高版本。"
          }
        }
      }
    },
