        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De volgende aflevering start in de speler van het hoofdvenster, en titel- en collectiepagina's rekken het venster niet meer op."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O próximo episódio começa no player da janela principal, e as páginas de títulos e coleções não esticam mais a janela."
          }
        },
        "ru" : {
          "stringUnit" : {
