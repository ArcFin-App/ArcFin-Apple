    "Folders on the server's own disk. Removing one takes its titles out of the library; the files stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ordner auf der Festplatte des Servers. Wenn du einen entfernst, verschwinden seine Titel aus der Mediathek; die Dateien bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Carpetas en el disco del propio servidor. Al quitar una, sus títulos salen de la biblioteca; los archivos se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dossiers sur le disque du serveur. En retirer un enlève ses titres de la médiathèque ; les fichiers restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cartelle sul disco del server. Rimuoverne una toglie i suoi titoli dalla libreria; i file restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サーバー自身のディスク上のフォルダです。外すとそのタイトルはライブラリから消えますが、ファイルは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "서버 자체 디스크의 폴더입니다. 하나를 빼면 그 항목이 보관함에서 빠지지만 파일은 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mappen op de schijf van de server zelf. Als je er een verwijdert, verdwijnen de titels uit de bibliotheek; de bestanden blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pastas no disco do próprio servidor. Remover uma tira os títulos dela da biblioteca; os arquivos continuam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Папки на диске самого сервера. Если убрать папку, её содержимое пропадёт из медиатеки, но файлы останутся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "服务器自己磁盘上的文件夹。移除后其中的内容会从资料库中消失，但文件仍会保留。"
          }
        }
      }
    },
