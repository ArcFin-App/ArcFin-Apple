        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sous 2 Go libres, les téléchargements vus les plus anciens partent en premier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sotto i 2 GB liberi, i download visti più vecchi vengono rimossi per primi."
          }
        },
        "ja" : {
