        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "privacy.apple.com › Ottieni una copia dei tuoi dati › Apple Media Services. Scegli Apple Music Play Activity.csv o Play History Daily Tracks.csv."
          }
        },
        "ja" : {
          "stringUnit" : {
