          }
        }
      }
    },
    "Each library in Browse shows how many titles it holds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Mediathek unter Durchsuchen zeigt, wie viele Titel sie enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada biblioteca en Explorar muestra cuántos títulos contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque bibliothèque dans Parcourir indique combien de titres elle contient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni libreria in Sfoglia mostra quanti titoli contiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ブラウズ」の各ライブラリに、収録されている作品数が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탐색의 각 보관함에 들어 있는 타이틀 수가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke bibliotheek in Bladeren laat zien hoeveel titels erin staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada biblioteca em Explorar mostra quantos títulos ela tem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая медиатека в разделе «Обзор библиотек» показывает, сколько в ней тайтлов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“浏览”中的每个资料库都会显示其中的作品数量。"
          }
        }
      }
    },
    "Each service emails a link when the file is ready, which can take a few days. Open the zip in Files, then pick the files inside." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Dienst schickt einen Link per E-Mail, wenn die Datei fertig ist; das kann einige Tage dauern. Öffne die ZIP-Datei in Dateien und wähle die Dateien darin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada servicio envía un enlace por correo cuando el archivo está listo, lo que puede tardar unos días. Abre el zip en Archivos y elige los archivos que contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque service envoie un lien par e-mail quand le fichier est prêt, ce qui peut prendre quelques jours. Ouvrez le zip dans Fichiers, puis choisissez les fichiers qu’il contient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni servizio invia un link via email quando il file è pronto, il che può richiedere qualche giorno. Apri lo zip in File, poi scegli i file al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各サービスからファイルの準備ができるとリンクがメールで届きます（数日かかる場合があります）。「ファイル」でzipを開き、中のファイルを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 서비스는 파일이 준비되면 링크를 이메일로 보내며, 며칠 걸릴 수 있습니다. 파일 앱에서 zip을 연 다음 안의 파일을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke dienst mailt een link als het bestand klaar is, wat een paar dagen kan duren. Open de zip in Bestanden en kies de bestanden erin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada serviço envia um link por e-mail quando o arquivo fica pronto, o que pode levar alguns dias. Abra o zip no app Arquivos e escolha os arquivos dentro dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый сервис присылает ссылку по почте, когда файл готов, — это может занять несколько дней. Откройте zip в «Файлах» и выберите файлы внутри."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件准备好后，各服务会通过电子邮件发送链接，可能需要几天时间。在“文件”中打开 zip，然后选择其中的文件。"
          }
        }
      }
    },
