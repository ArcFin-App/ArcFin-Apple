        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이어서 시청하기나 다음 볼 작품에 있어도 스마트 다운로드는 이 항목을 다운로드하지 않습니다."
          }
        },
        "nl" : {
