    "Off, downloads wait for Wi-Fi. Charges may apply." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aus: Downloads warten auf WLAN. Es können Kosten entstehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactivado: las descargas esperan a la wifi. Puede haber cargos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désactivé, les téléchargements attendent le Wi-Fi. Des frais peuvent s’appliquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Disattivato, i download attendono il Wi-Fi. Potrebbero essere applicati costi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "オフの場合、ダウンロードはWi-Fiを待ちます。料金が発生する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "끄면 다운로드가 Wi-Fi를 기다립니다. 요금이 부과될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uit: downloads wachten op wifi. Er kunnen kosten in rekening worden gebracht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desativado, os downloads aguardam o Wi-Fi. Podem ser cobradas tarifas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выкл.: загрузки ждут Wi-Fi. Может взиматься плата."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "关闭时，下载会等待无线局域网。可能会产生费用。"
          }
        }
      }
    },
