    },
    "This clears the saved server URL and credentials. You can reconnect any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit werden die gespeicherte Server-URL und die Zugangsdaten gelöscht. Du kannst dich jederzeit neu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto borra la URL del servidor y las credenciales guardadas. Puedes volver a conectarte cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cela efface l’URL du serveur et les identifiants enregistrés. Vous pouvez vous reconnecter à tout moment."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Isso apaga a URL do servidor e as credenciais salvas. Você pode se reconectar a qualquer momento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这会清除已存储的服务器 URL 和凭证。你可以随时重新连接。"
          }
        }
      }
    },
    "This download will be converted on your server before downloading — this may take longer than the file size alone suggests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Download wird vor dem Laden auf deinem Server umgewandelt – das kann länger dauern, als die Dateigröße vermuten lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta descarga se convertirá en tu servidor antes de descargarse; puede tardar más de lo que indica el tamaño del archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce téléchargement sera converti sur votre serveur avant le téléchargement — cela peut prendre plus de temps que la taille du fichier ne le laisse penser."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este download será convertido no seu servidor antes de baixar — isso pode levar mais tempo do que o tamanho do arquivo sugere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
