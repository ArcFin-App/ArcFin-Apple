    "How far it can move them earlier. A longer reach reads further ahead over the network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie weit es sie nach vorne verschieben kann. Ein größerer Bereich liest übers Netzwerk weiter voraus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hasta dónde puede adelantarlos. Un alcance mayor lee más por delante a través de la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jusqu'où il peut les avancer. Une portée plus longue lit plus loin à l'avance sur le réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Di quanto può anticiparli. Un intervallo più ampio legge più avanti tramite la rete."
