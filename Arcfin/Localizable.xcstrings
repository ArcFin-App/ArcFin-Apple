        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "privacy.apple.com › Obtenir une copie de vos données › Apple Media Services. Choisissez Apple Music Play Activity.csv ou Play History Daily Tracks.csv."
