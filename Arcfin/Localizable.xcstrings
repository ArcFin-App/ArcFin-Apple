    "Pick a longer period, go back to an earlier one, or come back once you've finished something." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle einen längeren Zeitraum, geh zu einem früheren zurück oder komm wieder, wenn du etwas beendet hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige un periodo más largo, vuelve a uno anterior o regresa cuando hayas terminado algo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez une période plus longue, revenez à une précédente ou revenez quand vous aurez terminé quelque chose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli un periodo più lungo, torna a uno precedente o ritorna quando avrai finito qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "もっと長い期間を選ぶか、前の期間に戻るか、何かを見終わってからまた来てください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "더 긴 기간을 선택하거나 이전 기간으로 돌아가거나 무언가를 끝까지 본 후 다시 오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kies een langere periode, ga terug naar een eerdere of kom terug als je iets hebt uitgekeken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha um período maior, volte a um anterior ou volte quando terminar algo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите более длинный период, вернитесь к предыдущему или загляните, когда что-нибудь досмотрите."
          }
        },
