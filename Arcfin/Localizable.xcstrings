    "Download songs, albums, playlists or everything by an artist, and keep favourites downloaded automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Songs, Alben, Playlists oder alles von einem Künstler herunter und lass Favoriten automatisch heruntergeladen halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga canciones, álbumes, listas o todo lo de un artista, y mantén tus favoritos descargados automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez des morceaux, des albums, des listes de lecture ou tout un artiste, et gardez vos favoris téléchargés automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica brani, album, playlist o tutto di un artista e tieni i preferiti scaricati automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲、アルバム、プレイリスト、またはアーティストの全曲をダウンロードでき、お気に入りは自動でダウンロードしておけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노래, 앨범, 재생 목록 또는 아티스트의 모든 곡을 다운로드하고, 즐겨찾기는 자동으로 다운로드된 상태로 유지하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download nummers, albums, afspeellijsten of alles van een artiest, en houd favorieten automatisch gedownload."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe músicas, álbuns, playlists ou tudo de um artista e mantenha seus favoritos baixados automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружайте песни, альбомы, плейлисты или всё от одного исполнителя, а избранное пусть загружается автоматически."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载歌曲、专辑、播放列表或某位艺人的全部作品，并让收藏内容自动保持下载。"
          }
        }
      }
    },
    "Download songs, albums, playlists or everything by an artist, and play them from the music bar without a connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Songs, Alben, Playlists oder alles von einem Künstler herunter und spiele sie ohne Verbindung über die Musikleiste ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga canciones, álbumes, listas o todo lo de un artista y reprodúcelos desde la barra de música sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargez des morceaux, des albums, des listes de lecture ou tout un artiste, et écoutez-les depuis la barre musicale sans connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica brani, album, playlist o tutto di un artista e ascoltali dalla barra della musica anche senza connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲、アルバム、プレイリスト、またはアーティストの全曲をダウンロードして、接続がなくてもミュージックバーから再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노래, 앨범, 재생 목록 또는 아티스트의 모든 곡을 다운로드하고 연결 없이도 음악 바에서 재생하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download nummers, albums, afspeellijsten of alles van een artiest, en speel ze zonder verbinding af via de muziekbalk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe músicas, álbuns, playlists ou tudo de um artista e ouça pela barra de música mesmo sem conexão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружайте песни, альбомы, плейлисты или всё от одного исполнителя и слушайте их из музыкальной панели без подключения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载歌曲、专辑、播放列表或某位艺人的全部作品，无需联网即可从音乐栏播放。"
          }
        }
      }
