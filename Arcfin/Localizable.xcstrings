    "Each gets a Popular on … row on Home, in this order." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeder bekommt auf der Startseite eine Reihe „Beliebt auf …“, in dieser Reihenfolge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada uno tiene una fila Populares en … en el inicio, en este orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chacun obtient une rangée Populaire sur … dans l’accueil, dans cet ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ognuno ha una riga Popolari su … nella Home, in questo ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "それぞれホームに「…で人気」の列がこの順番で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 서비스는 홈에 ‘…에서 인기’ 줄이 이 순서대로 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elk krijgt een rij ‘Populair op …’ op Start, in deze volgorde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada um ganha uma fileira Popular em … no Início, nesta ordem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каждый сервис получает ряд «Популярное на …» на главной, в этом порядке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每个服务都会在首页获得一行“…上的热门”，按此顺序排列。"
          }
        }
      }
    },
    "Each gets a Popular on … row on Home, in this order. Press and hold one to move it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeder bekommt auf der Startseite eine Reihe „Beliebt auf …“, in dieser Reihenfolge. Halte einen gedrückt, um ihn zu verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada uno tiene una fila Populares en … en el inicio, en este orden. Mantén pulsado uno para moverlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chacun obtient une rangée Populaire sur … dans l’accueil, dans cet ordre. Maintenez-en un pour le déplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ognuno ha una riga Popolari su … nella Home, in questo ordine. Tieni premuto per spostarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "それぞれホームに「…で人気」の列がこの順番で表示されます。長押しすると移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 서비스는 홈에 ‘…에서 인기’ 줄이 이 순서대로 표시됩니다. 길게 눌러 이동하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elk krijgt een rij ‘Populair op …’ op Start, in deze volgorde. Houd er een ingedrukt om hem te verplaatsen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada um ganha uma fileira Popular em … no Início, nesta ordem. Toque e segure um para movê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каждый сервис получает ряд «Популярное на …» на главной, в этом порядке. Нажмите и удерживайте, чтобы переместить."
