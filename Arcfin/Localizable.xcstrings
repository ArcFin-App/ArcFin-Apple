    "Used automatically when this device is on the saved home Wi-Fi network. Arcfin needs Location access to read the network's name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird automatisch genutzt, wenn dieses Gerät im gespeicherten WLAN zu Hause ist. Arcfin braucht Zugriff auf den Standort, um den Namen des Netzwerks zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa automáticamente cuando este dispositivo está en la red wifi de casa guardada. Arcfin necesita acceso a la ubicación para leer el nombre de la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisée automatiquement quand cet appareil est sur le réseau Wi-Fi du domicile enregistré. Arcfin a besoin de la localisation pour lire le nom du réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato automaticamente quando questo dispositivo è sulla rete Wi-Fi di casa salvata. Arcfin ha bisogno dell’accesso alla posizione per leggere il nome della rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスが保存された自宅のWi-Fiネットワークにあるときに自動で使用されます。ネットワーク名を読み取るには、Arcfinに位置情報へのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기가 저장된 집 Wi-Fi 네트워크에 있으면 자동으로 사용됩니다. 네트워크 이름을 읽으려면 Arcfin에 위치 접근 권한이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt automatisch gebruikt als dit apparaat op het bewaarde wifinetwerk thuis zit. Arcfin heeft toegang tot locatie nodig om de naam van het netwerk te lezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado automaticamente quando este dispositivo está na rede Wi-Fi de casa salva. O Arcfin precisa de acesso à localização para ler o nome da rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется автоматически, когда устройство в сохранённой домашней сети Wi-Fi. Чтобы узнать название сети, Arcfin нужен доступ к геопозиции."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当此设备在已存储的家庭无线局域网上时自动使用。Arcfin 需要位置访问权限才能读取网络名称。"
          }
        }
      }
