            "value" : "S’affiche sur %@ pendant 15 secondes."
          }
        }
      }
    },
    "Shows only what's downloaded, without connecting to your server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt nur Heruntergeladenes, ohne Verbindung zu deinem Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra solo lo descargado, sin conectarse a tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "N’affiche que ce qui est téléchargé, sans se connecter à votre serveur."
          }
        }
      }
    },
    "Shows Play Trailer when the server has a trailer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt „Trailer abspielen“, wenn der Server einen Trailer hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra Reproducir tráiler cuando el servidor tiene un tráiler."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Affiche Lire la bande-annonce quand le serveur a une bande-annonce."
          }
        }
      }
    },
    "Shows set to Keep Downloaded from their page download straight away, outside the storage budget, and stop under 2 GB free. Swipe to stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Serien, die auf ihrer Seite auf „Heruntergeladen behalten“ stehen, laden sofort, außerhalb des Speicherbudgets, und stoppen unter 2 GB freiem Speicher. Zum Stoppen wischen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las series marcadas como Mantener descargado en su página se descargan enseguida, fuera del presupuesto de almacenamiento, y se detienen con menos de 2 GB libres. Desliza para detener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les séries réglées sur Garder téléchargé depuis leur page se téléchargent immédiatement, hors budget de stockage, et s’arrêtent sous 2 Go libres. Balayez pour arrêter."
          }
        }
      }
    },
    "Shows the Cast button when a Chromecast is on your network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt die Cast-Taste, wenn ein Chromecast in deinem Netzwerk ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra el botón de Cast cuando hay un Chromecast en tu red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Affiche le bouton Cast quand un Chromecast est sur votre réseau."
          }
        }
      }
    },
    "Shows them as one row instead of two." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt sie als eine Reihe statt zwei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las muestra como una sola fila en lugar de dos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les affiche en une seule rangée au lieu de deux."
          }
        }
      }
    },
    "Shows your library's artwork when the remote hasn't been used for a while, except during playback. Press any button to go back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt die Artworks deiner Mediathek, wenn die Fernbedienung eine Weile nicht benutzt wurde, außer während der Wiedergabe. Drück eine beliebige Taste, um zurückzugehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra las imágenes de tu biblioteca cuando el mando no se ha usado durante un rato, excepto durante la reproducción. Pulsa cualquier botón para volver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Affiche les illustrations de votre bibliothèque quand la télécommande n’a pas servi depuis un moment, sauf pendant la lecture. Appuyez sur n’importe quel bouton pour revenir."
          }
        }
      }
