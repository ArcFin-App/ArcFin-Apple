    "Arcfin has a new coral colour and a new app icon, in light and dark appearance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin hat eine neue Korallenfarbe und ein neues App-Symbol, im hellen und im dunklen Erscheinungsbild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin tiene un nuevo color coral y un nuevo icono, en modo claro y oscuro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin adopte une nouvelle couleur corail et une nouvelle icône, en apparence claire comme sombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin ha un nuovo colore corallo e una nuova icona, sia nell'aspetto chiaro sia in quello scuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin に新しいコーラルカラーと新しいアプリアイコンが登場しました。ライトモードとダークモードの両方に対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin에 새로운 코랄 색상과 새 앱 아이콘이 적용되었습니다. 라이트 모드와 다크 모드 모두 지원합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin heeft een nieuwe koraalkleur en een nieuw appsymbool, in de lichte en donkere weergave."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Arcfin ganhou uma nova cor coral e um novo ícone, nos modos claro e escuro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Arcfin новый коралловый цвет и новый значок — в светлом и тёмном оформлении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin 换上了新的珊瑚色和新的 App 图标，浅色和深色外观都适用。"
          }
        }
      }
    },
