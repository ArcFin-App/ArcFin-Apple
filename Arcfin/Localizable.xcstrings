          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PIN을 설정하면 Arcfin을 열 때와 이 프로필로 전환하기 전에 PIN을 묻습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
