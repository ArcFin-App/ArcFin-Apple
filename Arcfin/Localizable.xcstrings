        }
      }
    },
    "Arcfin picks the right player for each video. You can choose one yourself in Settings › Playback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfin wählt für jedes Video den passenden Player. Du kannst ihn auch selbst unter Einstellungen › Wiedergabe wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfin elige el reproductor adecuado para cada vídeo. También puedes elegirlo tú en Ajustes › Reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfin choisit le bon lecteur pour chaque vidéo. Vous pouvez aussi le choisir dans Réglages › Lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfin sceglie il player giusto per ogni video. Puoi anche sceglierlo tu in Impostazioni › Riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfinはビデオごとに最適なプレーヤーを選びます。「設定」›「再生」で自分で選ぶこともできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfin이 동영상마다 알맞은 플레이어를 고릅니다. 설정 › 재생에서 직접 고를 수도 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfin kiest voor elke video de juiste speler. Je kunt er ook zelf een kiezen in Instellingen › Afspelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Arcfin escolhe o player certo para cada vídeo. Você também pode escolher em Ajustes › Reprodução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfin подбирает подходящий плеер для каждого видео. Его можно выбрать и самому в разделе Настройки › Воспроизведение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfin 会为每个视频选择合适的播放器。你也可以在“设置”›“播放”中自行选择。"
          }
        }
      }
    },
