    "Quick Connect request failed (server returned HTTP %lld). If Quick Connect is enabled in Dashboard > General, check the server URL and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick-Connect-Anfrage fehlgeschlagen (Server antwortete mit HTTP %lld). Wenn Quick Connect unter Dashboard > Allgemein aktiviert ist, prüfe die Serveradresse und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud de conexión rápida ha fallado (el servidor ha respondido HTTP %lld). Si la conexión rápida está activada en Panel > General, comprueba la dirección del servidor y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La demande de connexion rapide a échoué (le serveur a répondu HTTP %lld). Si la connexion rapide est activée dans Tableau de bord > Général, vérifiez l’adresse du serveur et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesta di connessione rapida non riuscita (il server ha risposto HTTP %lld). Se la connessione rapida è attiva in Dashboard > Generale, controlla l’indirizzo del server e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クイック接続のリクエストに失敗しました（サーバの応答: HTTP %lld）。「ダッシュボード > 一般」でクイック接続が有効なら、サーバのアドレスを確認してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠른 연결 요청이 실패했습니다(서버 응답 HTTP %lld). 대시보드 > 일반에서 빠른 연결이 켜져 있다면 서버 주소를 확인하고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzoek voor snel verbinden mislukt (server gaf HTTP %lld). Als snel verbinden aanstaat in Dashboard > Algemeen, controleer dan het serveradres en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A solicitação de conexão rápida falhou (o servidor respondeu HTTP %lld). Se a conexão rápida estiver ativada em Painel > Geral, verifique o endereço do servidor e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
