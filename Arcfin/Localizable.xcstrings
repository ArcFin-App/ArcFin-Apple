    "ListenBrainz stopped taking listens. Try again later; plays already sent aren't counted twice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ListenBrainz nimmt keine Wiedergaben mehr an. Versuche es später erneut; bereits gesendete werden nicht doppelt gezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ListenBrainz dejó de aceptar reproducciones. Inténtalo más tarde; las ya enviadas no se cuentan dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ListenBrainz n’accepte plus d’écoutes. Réessayez plus tard ; celles déjà envoyées ne sont pas comptées deux fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ListenBrainz ha smesso di accettare ascolti. Riprova più tardi; quelli già inviati non vengono contati due volte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ListenBrainzが受け付けを停止しました。後でもう一度お試しください。送信済みの再生が二重に数えられることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ListenBrainz가 재생 기록을 더 받지 않습니다. 나중에 다시 시도하세요. 이미 보낸 재생은 중복으로 집계되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ListenBrainz neemt geen afspeelbeurten meer aan. Probeer het later opnieuw; al verstuurde worden niet dubbel geteld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ListenBrainz parou de aceitar reproduções. Tente mais tarde; as já enviadas não são contadas duas vezes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ListenBrainz перестал принимать прослушивания. Повторите позже — уже отправленные не будут учтены дважды."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ListenBrainz 已停止接收播放记录。请稍后重试；已发送的记录不会重复计算。"
          }
        }
      }
    },
    "ListenBrainz turned this token down. Nothing is sent until you save a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
