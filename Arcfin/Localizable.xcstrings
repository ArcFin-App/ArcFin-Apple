    },
    "The code has expired or was already used. Get a new code on the Apple TV and scan it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Code ist abgelaufen oder wurde schon verwendet. Hol dir auf dem Apple TV einen neuen Code und scanne ihn erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El código ha caducado o ya se usó. Obtén uno nuevo en el Apple TV y vuelve a escanearlo."
