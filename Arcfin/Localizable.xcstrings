          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O outro dispositivo parou de responder antes de confirmar. Verifique se ele está conectado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другое устройство перестало отвечать до подтверждения. Проверьте, выполнен ли вход."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
