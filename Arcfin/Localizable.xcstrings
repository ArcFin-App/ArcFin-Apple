          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Springknoppen verschijnen als je server weet waar een samenvatting, intro, aftiteling of voorvertoning zit, via de plugins Intro Skipper, Chapter Segments Provider of SkipMe.db."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
