    "New to Arcfin, or want a refresher? Take the tour any time from Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neu bei Arcfin oder brauchst du eine Auffrischung? Starte die Tour jederzeit in den Einstellungen."
          }
