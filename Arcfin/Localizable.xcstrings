    "Smart Downloads checks after a download finishes, when you open the app, when the connection returns and when you close the player." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Smart Downloads prüft, nachdem ein Download fertig ist, wenn du die App öffnest, wenn die Verbindung zurückkommt und wenn du den Player schließt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las Descargas inteligentes comprueban cuando termina una descarga, al abrir la app, cuando vuelve la conexión y al cerrar el reproductor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les Téléchargements intelligents vérifient après la fin d’un téléchargement, à l’ouverture de l’app, au retour de la connexion et à la fermeture du lecteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I Download intelligenti controllano al termine di un download, all’apertura dell’app, al ritorno della connessione e alla chiusura del player."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スマートダウンロードは、ダウンロードの完了時、アプリを開いたとき、接続が戻ったとき、プレーヤーを閉じたときに確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스마트 다운로드는 다운로드가 끝난 후, 앱을 열 때, 연결이 돌아올 때, 플레이어를 닫을 때 확인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slimme downloads controleert nadat een download klaar is, als je de app opent, als de verbinding terugkomt en als je de speler sluit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os Downloads inteligentes verificam depois que um download termina, quando você abre o app, quando a conexão volta e quando você fecha o player."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Умные загрузки проверяют после завершения загрузки, при открытии приложения, при восстановлении подключения и при закрытии плеера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
