        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'무슨 노래일까요?'의 노래 인식은 Shazam에서 제공합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziekherkenning in ‘Wat speelt er?’ wordt geleverd door Shazam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reconhecimento de músicas em “O que está tocando?” é fornecido pelo Shazam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознавание песен в разделе «Что играет?» обеспечивает Shazam."
