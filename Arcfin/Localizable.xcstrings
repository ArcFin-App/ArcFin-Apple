    "Turning a shelf off hides it from Home — it still only shows when it actually has content." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine ausgeschaltete Reihe wird auf der Startseite ausgeblendet. Sie erscheint ohnehin nur, wenn sie Inhalte hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al desactivar una fila se oculta en Inicio; de todos modos solo aparece cuando tiene contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver une rangée la masque de l’accueil ; elle n’apparaît de toute façon que si elle a du contenu."
          }
        },
        "it" : {
          "stringUnit" : {
