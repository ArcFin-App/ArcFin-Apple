          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "녹화가 모든 사용자에게서 서버에서 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
