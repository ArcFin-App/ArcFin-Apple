        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "소리가 완전히 줄어 있는 동안 자막을 켜고, 소리가 돌아오면 다시 끕니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zet ondertitels aan terwijl het geluid helemaal uit staat, en weer uit als het terugkomt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
