    "Jellyfin %@ is newer than Arcfin has been checked with. Saving still works, but Arcfin asks first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin %@ ist neuer als die geprüften Versionen. Speichern geht weiterhin, Arcfin fragt aber vorher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin %@ es más reciente que las versiones probadas con Arcfin. Puedes guardar, pero Arcfin te preguntará antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin %@ est plus récent que les versions vérifiées avec Arcfin. L'enregistrement fonctionne, mais Arcfin demande d'abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin %@ è più recente delle versioni verificate con Arcfin. Il salvataggio funziona, ma Arcfin chiede prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin %@はArcfinで確認したバージョンより新しいです。保存はできますが、先に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin %@은(는) Arcfin에서 확인한 버전보다 최신입니다. 저장은 되지만 먼저 확인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin %@ is nieuwer dan Arcfin is gecontroleerd. Opslaan werkt nog, maar Arcfin vraagt het eerst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Jellyfin %@ é mais novo do que as versões verificadas com o Arcfin. Dá para salvar, mas o Arcfin pergunta antes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin %@ новее версий, с которыми проверялся Arcfin. Сохранять можно, но Arcfin сначала спросит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jellyfin %@ 比 Arcfin 已验证的版本更新。仍可保存，但 Arcfin 会先询问。"
          }
        }
      }
    },
    "Jellyfin %@ is older than 10.9: lyrics, Sound Check and trickplay need 10.9 or later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin %@ ist älter als 10.9: Liedtexte, Lautstärkeausgleich und Trickplay brauchen 10.9 oder neuer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin %@ es anterior a 10.9: las letras, Ajustar volumen y trickplay necesitan 10.9 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin %@ est antérieur à 10.9 : les paroles, Égaliseur de volume et le trickplay nécessitent 10.9 ou ultérieur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin %@ è precedente alla 10.9: testi, Ottimizzazione volume e trickplay richiedono la 10.9 o successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin %@ は10.9より古いバージョンです。歌詞、サウンドチェック、トリックプレイには10.9以降が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin %@은(는) 10.9보다 오래된 버전입니다. 가사, 사운드 체크, 트릭플레이에는 10.9 이상이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin %@ is ouder dan 10.9: songteksten, Geluidscontrole en trickplay vereisen 10.9 of nieuwer."
          }
        },
