        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próximo episódio, mesma janela"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующая серия в том же окне"
