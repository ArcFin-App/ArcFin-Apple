        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "채널을 시작하는 데 너무 오래 걸렸습니다. 소스가 느리거나 오프라인일 수 있습니다. 다시 시도하거나 다른 채널을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
