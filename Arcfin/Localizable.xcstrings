        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este canal não está mais no servidor. Puxe a lista de canais para baixo para atualizá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Этого канала больше нет на сервере. Потяните список каналов вниз, чтобы обновить его."
