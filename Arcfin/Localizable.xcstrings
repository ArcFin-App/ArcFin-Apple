    "All of your server's tuners are busy. Stop watching or recording on another device, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle Tuner deines Servers sind belegt. Beende das Ansehen oder Aufnehmen auf einem anderen Gerät und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todos los sintonizadores de tu servidor están ocupados. Deja de ver o grabar en otro dispositivo y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tous les tuners de votre serveur sont occupés. Arrêtez la lecture ou l'enregistrement sur un autre appareil, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutti i sintonizzatori del server sono occupati. Interrompi la visione o la registrazione su un altro dispositivo, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サーバーのチューナーがすべて使用中です。別のデバイスでの視聴や録画を止めてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "서버의 모든 튜너가 사용 중입니다. 다른 기기에서 시청이나 녹화를 중지한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle tuners van je server zijn bezet. Stop met kijken of opnemen op een ander apparaat en probeer het dan opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todos os sintonizadores do servidor estão ocupados. Pare de assistir ou gravar em outro dispositivo e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Все тюнеры сервера заняты. Остановите просмотр или запись на другом устройстве и попробуйте снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "服务器的所有调谐器都在使用中。请在其他设备上停止观看或录制，然后重试。"
          }
        }
      }
    },
