        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Au départ, il voit toutes les médiathèques. Sans mot de passe, il se connecte sans en saisir."
          }
        },
        "it" : {
          "stringUnit" : {
