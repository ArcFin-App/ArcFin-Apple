    "This server uses Seerr to handle media requests and more. Connect it with your Jellyfin account (%@); there's no password to type." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Server nutzt Seerr für Medienanfragen und mehr. Verbinde es mit deinem Jellyfin-Konto (%@) – ein Passwort musst du nicht eingeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este servidor usa Seerr para gestionar solicitudes de contenido y más. Conéctalo con tu cuenta de Jellyfin (%@); no hace falta escribir ninguna contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce serveur utilise Seerr pour les demandes de contenus et plus encore. Connectez-le avec votre compte Jellyfin (%@) ; aucun mot de passe à saisir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
