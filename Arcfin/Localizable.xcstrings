    "Plays a live TV channel from your server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spielt einen Live-TV-Sender von deinem Server ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reproduce un canal de TV en directo de tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lit une chaîne de TV en direct de votre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Riproduce un canale TV in diretta dal tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サーバーのライブTVチャンネルを再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "서버의 실시간 TV 채널을 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Speelt een live-tv-zender van je server af."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reproduz um canal de TV ao vivo do seu servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Включает канал прямого эфира с вашего сервера."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "播放服务器上的电视直播频道。"
          }
        }
      }
    },
    "Plays a movie or episode from where you left off, or a series from its next episode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spielt einen Film oder eine Folge ab da, wo du aufgehört hast, oder eine Serie ab der nächsten Folge."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reproduce una película o episodio donde lo dejaste, o una serie desde su siguiente episodio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lit un film ou un épisode là où vous vous étiez arrêté, ou une série à partir de son prochain épisode."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Riproduce un film o un episodio da dove eri rimasto, o una serie dal prossimo episodio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "映画やエピソードは前回の続きから、シリーズは次のエピソードから再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "영화나 에피소드는 멈춘 곳부터, 시리즈는 다음 에피소드부터 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Speelt een film of aflevering af waar je was gebleven, of een serie vanaf de volgende aflevering."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reproduz um filme ou episódio de onde você parou, ou uma série a partir do próximo episódio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Воспроизводит фильм или эпизод с места остановки, а сериал — со следующего эпизода."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "从上次停止的位置播放电影或单集，或从下一集开始播放剧集。"
          }
        }
      }
    },
    "Plays a movie you haven't watched yet, picked at random." : {
