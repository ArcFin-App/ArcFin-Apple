    "The server answered with an error (HTTP %lld). If Jellyfin is behind a reverse proxy, check that Jellyfin is running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Server hat mit einem Fehler geantwortet (HTTP %lld). Wenn Jellyfin hinter einem Reverse-Proxy läuft, prüfe, ob Jellyfin gestartet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El servidor respondió con un error (HTTP %lld). Si Jellyfin está detrás de un proxy inverso, comprueba que Jellyfin esté en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le serveur a répondu par une erreur (HTTP %lld). Si Jellyfin est derrière un proxy inverse, vérifiez que Jellyfin est en cours d'exécution."
