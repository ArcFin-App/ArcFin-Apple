    "Saved to your Jellyfin account, so it applies in its other apps too. Home updates the next time it refreshes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deinem Jellyfin-Konto gesichert, gilt also auch in seinen anderen Apps. Die Startseite ändert sich, wenn sie das nächste Mal aktualisiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en tu cuenta de Jellyfin, así que también se aplica en sus otras apps. Inicio se actualiza la próxima vez que se refresque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré dans votre compte Jellyfin, donc appliqué aussi dans ses autres apps. L’accueil change à sa prochaine actualisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato nel tuo account Jellyfin, quindi vale anche nelle sue altre app. Home si aggiorna al prossimo aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfinアカウントに保存されるため、ほかのアプリにも反映されます。ホームは次に更新されたときに変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin 계정에 저장되므로 다른 앱에도 적용됩니다. 홈은 다음에 새로 고칠 때 바뀝니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaard in je Jellyfin-account, dus het geldt ook in de andere apps. Thuis verandert de volgende keer dat het ververst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo na sua conta do Jellyfin, então vale também nos outros apps. O Início muda na próxima vez que atualizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняется в вашей учётной записи Jellyfin, поэтому действует и в других её приложениях. Главная обновится при следующем обновлении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储在你的 Jellyfin 账户中，因此也适用于其他 App。主页会在下次刷新时更新。"
          }
        }
      }
    },
