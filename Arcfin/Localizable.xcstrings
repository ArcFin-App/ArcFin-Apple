    "%@. Save or send it, then attach it to your issue or support request." : {
      "comment" : "A button that opens a share sheet with a file attached. The argument is the name of the file, and the second argument is a description of the file's purpose.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Speichere oder sende die Datei und hänge sie dann an dein Issue oder deine Supportanfrage an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Guárdalo o envíalo y luego adjúntalo a tu incidencia o solicitud de soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Enregistrez-le ou envoyez-le, puis joignez-le à votre ticket ou à votre demande d’assistance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Salvalo o invialo, poi allegalo alla tua segnalazione o richiesta di supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@。ファイルを保存または送信して、問題報告やサポートリクエストに添付してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. 파일을 저장하거나 보낸 다음 이슈나 지원 요청에 첨부하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Bewaar of verstuur het en voeg het daarna toe aan je melding of ondersteuningsverzoek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Salve ou envie o arquivo e depois anexe-o ao seu relato ou pedido de suporte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Сохраните или отправьте файл, затем приложите его к своему сообщению о проблеме или запросу в поддержку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@。保存或发送该文件，然后将其附加到你的问题报告或支持请求中。"
