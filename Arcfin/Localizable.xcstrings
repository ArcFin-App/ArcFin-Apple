    "Signs in to Seerr as %@ with your Jellyfin account. There's no password to type, and none is saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Meldet dich mit deinem Jellyfin-Konto als %@ bei Seerr an. Du musst kein Passwort eingeben, und es wird keins gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicia sesión en Seerr como %@ con tu cuenta de Jellyfin. No hay que escribir ninguna contraseña y no se guarda ninguna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vous connecte à Seerr en tant que %@ avec votre compte Jellyfin. Aucun mot de passe à saisir, et aucun n’est enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Accede a Seerr come %@ con il tuo account Jellyfin. Non devi digitare alcuna password e non ne viene salvata nessuna."
