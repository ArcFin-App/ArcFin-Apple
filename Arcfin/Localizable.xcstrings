    "Used automatically when this device is connected to the saved home Wi-Fi network. Requires the Access Wi-Fi Information capability." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wird automatisch genutzt, wenn dieses Gerät mit dem gespeicherten WLAN zu Hause verbunden ist. Erfordert die Berechtigung „Access Wi-Fi Information“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se usa automáticamente cuando este dispositivo está conectado a la red wifi de casa guardada. Requiere la capacidad Access Wi-Fi Information."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisée automatiquement quand cet appareil est connecté au réseau Wi-Fi du domicile enregistré. Nécessite la fonctionnalité Access Wi-Fi Information."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usado automaticamente quando este dispositivo está conectado à rede Wi-Fi de casa salva. Requer o recurso Access Wi-Fi Information."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "当此设备连接到已存储的家庭无线局域网时自动使用。需要 Access Wi-Fi Information 功能。"
          }
        }
      }
    },
    "Used instead when you're on mobile data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
