    "After 30 minutes the Apple TV's own screensaver and sleep settings take over." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach 30 Minuten übernehmen der Bildschirmschoner und die Ruhezustandseinstellungen des Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Después de 30 minutos toman el control el salvapantallas y los ajustes de reposo del Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Après 30 minutes, l’économiseur d’écran et les réglages de veille de l’Apple TV prennent le relais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopo 30 minuti subentrano il salvaschermo e le impostazioni di stop dell’Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "30分経つと、Apple TV本体のスクリーンセーバーとスリープ設定に切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "30분이 지나면 Apple TV 자체의 화면 보호기와 잠자기 설정이 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Na 30 minuten nemen de schermbeveiliging en sluimerinstellingen van de Apple TV het over."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
