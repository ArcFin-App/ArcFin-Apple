        }
      }
    },
    "Open Arcfin on the Apple TV, iPad or Mac and go to its sign-in page. It needs to be on the same network as this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Arcfin auf dem Apple TV, iPad oder Mac und geh zur Anmeldeseite. Es muss im selben Netzwerk wie dieses Gerät sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Arcfin en el Apple TV, iPad o Mac y ve a su página de inicio de sesión. Debe estar en la misma red que este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Arcfin sur l’Apple TV, l’iPad ou le Mac et allez à sa page de connexion. Il doit être sur le même réseau que cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Arcfin sull’Apple TV, iPad o Mac e vai alla pagina di accesso. Deve essere sulla stessa rete di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV、iPad、またはMacでArcfinを開き、サインインページに移動してください。このデバイスと同じネットワークにある必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV, iPad 또는 Mac에서 Arcfin을 열고 로그인 페이지로 이동하세요. 이 기기와 같은 네트워크에 있어야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Arcfin op de Apple TV, iPad of Mac en ga naar de inlogpagina. Het moet op hetzelfde netwerk zitten als dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o Arcfin no Apple TV, iPad ou Mac e vá à página de início de sessão. Ele precisa estar na mesma rede que este dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Arcfin на Apple TV, iPad или Mac и перейдите на страницу входа. Устройство должно быть в той же сети, что и это."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple TV、iPad 或 Mac 上打开 Arcfin 并前往其登录页面。它需要与此设备在同一网络中。"
          }
        }
      }
    },
