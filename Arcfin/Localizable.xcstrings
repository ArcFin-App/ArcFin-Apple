    "“%@” becomes %@, with its details and artwork." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@“ wird zu %2$@, mit dessen Details und Bildern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%1$@» pasa a ser %2$@, con sus detalles e imágenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« %1$@ » devient %2$@, avec ses informations et images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%1$@» diventa %2$@, con dettagli e immagini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「%1$@」は%2$@になり、その情報と画像が使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘%1$@’이(가) %2$@(으)로 바뀌며 해당 정보와 이미지를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘%1$@’ wordt %2$@, met de gegevens en afbeeldingen daarvan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@” passa a ser %2$@, com os detalhes e imagens dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%1$@» станет «%2$@» — с его сведениями и обложками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@”将变为%2$@，并使用其详细信息和图片。"
          }
        }
      }
    },
    "“%@” can now sign in. Set what they can watch and do on their page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%@“ kann sich jetzt anmelden. Was sie sehen und tun dürfen, legst du auf ihrer Seite fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» ya puede iniciar sesión. Configura en su página qué puede ver y hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« %@ » peut maintenant se connecter. Choisissez sur sa page ce qu'il peut regarder et faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» ora può accedere. Imposta nella sua pagina cosa può guardare e fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「%@」がサインインできるようになりました。視聴やできることはそのユーザのページで設定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이제 ‘%@’이(가) 로그인할 수 있습니다. 볼 수 있는 항목과 할 수 있는 작업은 해당 페이지에서 설정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘%@’ kan nu aanmelden. Stel op de pagina in wat diegene mag kijken en doen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@” já pode entrar. Defina na página da pessoa o que ela pode assistir e fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» теперь может войти. Что ему доступно, настройте на его странице."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@”现在可以登录了。在其页面上设置可观看的内容和可执行的操作。"
          }
        }
      }
    },
