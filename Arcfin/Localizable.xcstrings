    "Seerr uses the same Jellyfin account (%@) — this is only used to connect Seerr and isn't stored anywhere else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerr nutzt dasselbe Jellyfin-Konto (%@) – es wird nur zum Verbinden von Seerr genutzt und nirgendwo sonst gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerr usa la misma cuenta de Jellyfin (%@); solo se usa para conectar Seerr y no se guarda en ningún otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerr utilise le même compte Jellyfin (%@) — il ne sert qu’à connecter Seerr et n’est stocké nulle part ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerr usa lo stesso account Jellyfin (%@): serve solo a connettere Seerr e non viene salvato da nessun’altra parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerrは同じJellyfinアカウント（%@）を使用します。Seerrへの接続にのみ使用され、ほかの場所には保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerr는 같은 Jellyfin 계정(%@)을 사용합니다. Seerr 연결에만 사용되며 다른 곳에는 저장되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerr gebruikt hetzelfde Jellyfin-account (%@) — het wordt alleen gebruikt om Seerr te verbinden en nergens anders bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Seerr usa a mesma conta do Jellyfin (%@) — ela só é usada para conectar o Seerr e não é armazenada em nenhum outro lugar."
          }
