    "%@. Save or send it, then attach it to your issue or support request." : {
      "comment" : "A button that opens a share sheet with a file attached. The argument is the name of the file, and the second argument is a description of the file's purpose.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Speichere oder sende die Datei und hänge sie dann an dein Issue oder deine Supportanfrage an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Guárdalo o envíalo y luego adjúntalo a tu incidencia o solicitud de soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Enregistrez-le ou envoyez-le, puis joignez-le à votre ticket ou à votre demande d’assistance."
          }
        }
      }
    },
