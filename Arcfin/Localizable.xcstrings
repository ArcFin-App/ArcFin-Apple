    },
    "This clears the saved server URL and credentials. You can reconnect any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit werden die gespeicherte Server-URL und die Zugangsdaten gelöscht. Du kannst dich jederzeit neu verbinden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cela efface l’URL du serveur et les identifiants enregistrés. Vous pouvez vous reconnecter à tout moment."
          }
        }
      }
    },
    "This download will be converted on your server before downloading — this may take longer than the file size alone suggests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Download wird vor dem Laden auf deinem Server umgewandelt – das kann länger dauern, als die Dateigröße vermuten lässt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce téléchargement sera converti sur votre serveur avant le téléchargement — cela peut prendre plus de temps que la taille du fichier ne le laisse penser."
          }
        }
      }
    },
    "This is downloaded — play the offline copy or stream from the server?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das ist heruntergeladen – die Offline-Kopie abspielen oder vom Server streamen?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce titre est téléchargé — lire la copie hors ligne ou le diffuser depuis le serveur ?"
          }
        }
      }
    },
    "This is taking longer than usual." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das dauert länger als üblich."
