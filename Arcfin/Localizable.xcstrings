        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se usa cuando no estás en la red wifi de casa guardada abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisée quand vous n’êtes pas sur le réseau Wi-Fi du domicile enregistré ci-dessous."
          }
        },
