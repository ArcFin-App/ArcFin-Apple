        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サーバーがエラーを返しました（HTTP %lld）。Jellyfinがリバースプロキシの背後にある場合は、Jellyfinが起動しているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
