    "0 means no limit, or the server's own choice. The streaming limit applies to every connection from outside your network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0 bedeutet kein Limit bzw. die Wahl des Servers. Das Streaming-Limit gilt für jede Verbindung von außerhalb deines Netzwerks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0 significa sin límite, o que decide el servidor. El límite de streaming se aplica a toda conexión desde fuera de tu red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0 signifie aucune limite, ou le choix du serveur. La limite de streaming s'applique à chaque connexion extérieure à votre réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0 significa nessun limite, o la scelta del server. Il limite di streaming vale per ogni connessione da fuori della tua rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0は制限なし、またはサーバーの判断に任せることを意味します。ストリーミングの上限は、ネットワーク外からのすべての接続に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0은 제한 없음 또는 서버가 정하는 값을 뜻합니다. 스트리밍 제한은 네트워크 밖에서 오는 모든 연결에 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0 betekent geen limiet, of de keuze van de server. De streaminglimiet geldt voor elke verbinding van buiten je netwerk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0 significa sem limite, ou a escolha do servidor. O limite de streaming vale para toda conexão de fora da sua rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0 — без ограничения или на усмотрение сервера. Лимит потока действует для всех подключений извне вашей сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "0 表示不限制或由服务器决定。串流限制适用于来自你网络外部的每个连接。"
          }
        }
      }
    },
