    "Connect Seerr in Settings to find new movies and shows and ask for them on your server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verbinde Seerr in den Einstellungen, um neue Filme und Serien zu finden und sie für deinen Server anzufragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conecta Seerr en Ajustes para descubrir películas y series nuevas y pedirlas para tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Connectez Seerr dans les Réglages pour trouver de nouveaux films et séries et les demander sur votre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Collega Seerr nelle Impostazioni per trovare nuovi film e serie e richiederli sul tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "設定でSeerrを接続すると、新しい映画や番組を見つけてサーバにリクエストできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "설정에서 Seerr를 연결하면 새로운 영화와 시리즈를 찾아 서버에 요청할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koppel Seerr in Instellingen om nieuwe films en series te vinden en ze op je server aan te vragen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conecte o Seerr em Ajustes para encontrar novos filmes e séries e pedi-los no seu servidor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Подключите Seerr в настройках, чтобы находить новые фильмы и сериалы и запрашивать их на своём сервере."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在“设置”中连接 Seerr，即可发现新的电影和剧集，并请求将它们添加到你的服务器。"
          }
        }
      }
    },
