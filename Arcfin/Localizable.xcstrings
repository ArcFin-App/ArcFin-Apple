    "Your Seerr account can't request this. Ask your Seerr admin for request permission, or check your request limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Seerr-Konto kann das nicht anfragen. Bitte deinen Seerr-Admin um Anfragerechte oder prüfe dein Anfragelimit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de Seerr no puede solicitar esto. Pide permiso de solicitud a tu administrador de Seerr o revisa tu límite de solicitudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte Seerr ne peut pas demander ceci. Demandez l'autorisation à votre administrateur Seerr ou vérifiez votre limite de demandes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account Seerr non può richiederlo. Chiedi all'amministratore di Seerr il permesso di richiesta o controlla il tuo limite di richieste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Seerr アカウントではリクエストできません。Seerr の管理者にリクエスト権限を依頼するか、リクエスト上限を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Seerr 계정으로는 요청할 수 없습니다. Seerr 관리자에게 요청 권한을 받거나 요청 한도를 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Seerr-account kan dit niet aanvragen. Vraag je Seerr-beheerder om aanvraagrechten of controleer je aanvraaglimiet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta do Seerr não pode solicitar isto. Peça permissão de solicitação ao administrador do Seerr ou verifique seu limite de solicitações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша учётная запись Seerr не может это запросить. Попросите администратора Seerr выдать право на запросы или проверьте лимит запросов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Seerr 账户无法请求此内容。请向 Seerr 管理员申请请求权限，或检查你的请求限额。"
          }
        }
      }
    },
