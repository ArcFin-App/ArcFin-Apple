    "The rest download once there's room. Delete watched titles in Manage Storage to make some." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Rest wird geladen, sobald Platz ist. Lösche gesehene Titel unter „Speicher verwalten“, um Platz zu schaffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
