    },
    "They can see every library to begin with. A blank password lets them sign in without one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Anfangs sehen sie alle Mediatheken. Ohne Passwort können sie sich auch ohne anmelden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al principio ven todas las bibliotecas. Con la contraseña en blanco, entran sin ella."
