    "Auto picks from your connection; a fixed choice caps every stream." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auto wählt nach deiner Verbindung; eine feste Auswahl begrenzt jeden Stream."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automático elige según tu conexión; una opción fija limita todas las transmisiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auto choisit selon votre connexion ; un choix fixe plafonne chaque flux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automático escolhe pela sua conexão; uma opção fixa limita todos os streams."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“自动”会根据你的网络连接选择；固定选项会限制每个串流。"
          }
        }
      }
    },
    "Auto prefers Aether, which plays the most formats, HDR and surround. If a video won't play, try AVFoundation or VLC." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auto bevorzugt Aether, das die meisten Formate, HDR und Surround abspielt. Wenn ein Video nicht läuft, probiere AVFoundation oder VLC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automático prefiere Aether, que reproduce más formatos, HDR y sonido envolvente. Si un vídeo no se reproduce, prueba AVFoundation o VLC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auto privilégie Aether, qui lit le plus de formats, le HDR et le son surround. Si une vidéo ne se lit pas, essayez AVFoundation ou VLC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automático prefere o Aether, que reproduz mais formatos, HDR e som surround. Se um vídeo não tocar, tente AVFoundation ou VLC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“自动”优先使用 Aether，它能播放最多的格式、HDR 和环绕声。如果视频无法播放，请尝试 AVFoundation 或 VLC。"
          }
        }
      }
    },
