    "Lets Smart Downloads download on mobile data. Charges may apply." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erlaubt Smart Downloads über Mobilfunk. Es können Kosten entstehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permite que las Descargas inteligentes usen datos móviles. Puede haber cargos."
