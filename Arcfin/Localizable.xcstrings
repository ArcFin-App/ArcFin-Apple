    "After the restart, this device may not reach the server: Arcfin connects to it at %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Neustart erreicht dieses Gerät den Server womöglich nicht mehr: Arcfin verbindet sich mit %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras el reinicio, puede que este dispositivo no llegue al servidor: Arcfin se conecta a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après le redémarrage, cet appareil risque de ne plus joindre le serveur : Arcfin s'y connecte via %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo il riavvio questo dispositivo potrebbe non raggiungere il server: Arcfin si collega a %@."
