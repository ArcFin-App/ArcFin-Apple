    "Switches the display to the video's frame rate so motion doesn't judder. AVFoundation only; some TVs flash black when it switches." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stellt das Display auf die Bildrate des Videos um, damit Bewegungen nicht ruckeln. Nur AVFoundation; manche Fernseher werden beim Umschalten kurz schwarz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Règle l’écran sur la fréquence d’images de la vidéo pour éviter les saccades. AVFoundation uniquement ; certains téléviseurs passent au noir pendant le changement."
          }
        }
      }
    },
