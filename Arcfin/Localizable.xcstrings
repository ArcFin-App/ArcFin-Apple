    "Only %lld of %lld episodes fit right now (%@ free for downloads). The rest download once there's space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gerade passen nur %1$lld von %2$lld Folgen (%3$@ frei für Downloads). Der Rest wird geladen, sobald Platz ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ahora solo caben %1$lld de %2$lld episodios (%3$@ libres para descargas). El resto se descargará cuando haya espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seuls %1$lld épisodes sur %2$lld tiennent pour l'instant (%3$@ libres pour les téléchargements). Les autres se téléchargeront dès qu'il y aura de la place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al momento entrano solo %1$lld episodi su %2$lld (%3$@ liberi per i download). Gli altri verranno scaricati quando ci sarà spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今は%2$lldエピソード中%1$lldエピソードしか入りません（ダウンロードに使える空き %3$@）。残りは空きができしだいダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "지금은 %2$lld개 에피소드 중 %1$lld개만 들어갑니다(다운로드에 쓸 수 있는 공간 %3$@). 나머지는 공간이 생기면 다운로드됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Er passen nu maar %1$lld van %2$lld afleveringen (%3$@ vrij voor downloads). De rest wordt gedownload zodra er ruimte is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agora só cabem %1$lld de %2$lld episódios (%3$@ livres para downloads). O resto será baixado quando houver espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сейчас помещается только %1$lld из %2$lld серий (для загрузок свободно %3$@). Остальные загрузятся, когда освободится место."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "目前只能放下 %2$lld 集中的 %1$lld 集（可用于下载 %3$@）。其余的会在有空间后下载。"
          }
        }
      }
    },
