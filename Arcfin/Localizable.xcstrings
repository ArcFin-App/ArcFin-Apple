    "In Continue Watching and Next Up: the episode's own still, or its show's artwork." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In „Weiterschauen“ und „Als Nächstes“: das Standbild der Folge oder das Bild der Serie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En Seguir viendo y A continuación: la imagen del propio episodio o la de su serie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dans Reprendre et À suivre : l'image de l'épisode lui-même ou celle de sa série."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In Continua a guardare e Prossimi: l'immagine dell'episodio o quella della serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「視聴を続ける」と「次に見る」で、エピソード自体の画像か番組の画像を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이어서 보기와 다음 화에서 에피소드 자체 이미지 또는 프로그램 이미지를 표시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In Verder kijken en Volgende: de eigen still van de aflevering of de afbeelding van de serie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Em Continuar assistindo e A seguir: a imagem do próprio episódio ou a da série."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В «Продолжить просмотр» и «Далее»: кадр из самой серии или изображение сериала."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
