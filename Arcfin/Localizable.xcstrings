    },
    "The next episode starts in the main window's player, and title and collection pages no longer stretch the window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste Folge startet im Player des Hauptfensters, und Titel- und Sammlungsseiten ziehen das Fenster nicht mehr in die Breite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El siguiente episodio empieza en el reproductor de la ventana principal, y las páginas de títulos y colecciones ya no estiran la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'épisode suivant démarre dans le lecteur de la fenêtre principale, et les pages de titres et de collections n'étirent plus la fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'episodio successivo parte nel player della finestra principale, e le pagine di titoli e raccolte non allargano più la finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次のエピソードはメインウインドウのプレーヤーで始まり、作品やコレクションのページでウインドウが広がらなくなりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 에피소드가 메인 창의 플레이어에서 시작되며, 타이틀 및 컬렉션 페이지가 더 이상 창을 늘리지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De volgende aflevering start in de speler van het hoofdvenster, en titel- en collectiepagina's rekken het venster niet meer op."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O próximo episódio começa no player da janela principal, e as páginas de títulos e coleções não esticam mais a janela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующая серия начинается в плеере главного окна, а страницы тайтлов и коллекций больше не растягивают окно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
