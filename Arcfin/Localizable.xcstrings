    "Turning remote connections off signs out everyone outside your network, which may include this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wenn du Verbindungen von außen ausschaltest, werden alle außerhalb deines Netzwerks abgemeldet, eventuell auch dieses Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactivar las conexiones remotas cierra la sesión de todos los que estén fuera de tu red, puede que incluido este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désactiver les connexions à distance déconnecte toute personne hors de votre réseau, y compris peut-être cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Disattivare le connessioni remote disconnette chiunque sia fuori dalla tua rete, forse anche questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "リモート接続をオフにすると、ネットワーク外のすべての人がサインアウトされます。このデバイスも含まれる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "원격 연결을 끄면 네트워크 밖의 모든 사용자가 로그아웃되며, 이 기기도 포함될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Als je externe verbindingen uitzet, wordt iedereen buiten je netwerk afgemeld, mogelijk ook dit apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desativar as conexões remotas desconecta todos fora da sua rede, o que pode incluir este dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Если отключить удалённые подключения, все за пределами вашей сети выйдут из аккаунта — возможно, и это устройство."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "关闭远程连接会让你网络外的所有人退出登录，可能也包括这台设备。"
          }
        }
      }
    },
    "Turns on a subtitle track when a video starts." : {
