        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈이 추천 타이틀과 예고편으로 시작되며, 위아래 버튼으로 줄을 하나씩 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
