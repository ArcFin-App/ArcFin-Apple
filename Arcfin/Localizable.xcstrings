    },
    "These download straight away, outside the storage budget, and stop under 2 GB free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese werden sofort heruntergeladen, außerhalb des Speicherbudgets, und stoppen unter 2 GB freiem Speicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se descargan enseguida, fuera del límite de almacenamiento, y se detienen con menos de 2 GB libres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ils se téléchargent tout de suite, hors du budget de stockage, et s'arrêtent sous 2 Go libres."
          }
