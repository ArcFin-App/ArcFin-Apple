    "Your admin has the server convert everything you play away from home." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Admin lässt den Server alles umwandeln, was du unterwegs abspielst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu administrador hace que el servidor convierta todo lo que reproduces fuera de casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre administrateur fait convertir par le serveur tout ce que vous lisez hors domicile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’amministratore fa convertire al server tutto ciò che riproduci fuori casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者の設定により、外出先で再生するものはすべてサーバが変換します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리자 설정에 따라 외부에서 재생하는 모든 항목을 서버가 변환합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je beheerder laat de server alles omzetten wat je buitenshuis afspeelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu administrador faz o servidor converter tudo o que você reproduz fora de casa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администратор настроил сервер конвертировать всё, что вы воспроизводите вне дома."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理员让服务器转换你离家时播放的所有内容。"
          }
        }
      }
    },
    "Your admin limits streaming away from home to %@, below what this connection can do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Admin begrenzt Streaming unterwegs auf %@, weniger als diese Verbindung schafft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
