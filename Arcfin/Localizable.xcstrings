    "No answer from this address. A local address only answers on its own network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Antwort von dieser Adresse. Eine lokale Adresse antwortet nur im eigenen Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dirección no responde. Una dirección local solo responde en su propia red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune réponse de cette adresse. Une adresse locale ne répond que sur son propre réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna risposta da questo indirizzo. Un indirizzo locale risponde solo sulla sua rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスから応答がありません。ローカルアドレスは同じネットワーク上でのみ応答します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소에서 응답이 없습니다. 로컬 주소는 해당 네트워크에서만 응답합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen antwoord van dit adres. Een lokaal adres antwoordt alleen op het eigen netwerk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma resposta deste endereço. Um endereço local só responde na própria rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес не отвечает. Локальный адрес отвечает только в своей сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此地址无响应。本地地址仅在其所在网络中响应。"
          }
        }
      }
    },
    "No answer from this address. Check it, and that the server is reachable from outside." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Antwort von dieser Adresse. Prüfe sie und ob der Server von außen erreichbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dirección no responde. Revísala y comprueba que el servidor sea accesible desde fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
