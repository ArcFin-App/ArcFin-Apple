        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선반을 끄면 홈에서 숨겨집니다. 선반은 원래 콘텐츠가 있을 때만 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
