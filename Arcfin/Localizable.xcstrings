    "Shapes the sound of everything that plays here, including on AirPlay. Not on a Chromecast." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formt den Klang von allem, was hier abgespielt wird, auch über AirPlay. Nicht auf einem Chromecast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el sonido de todo lo que se reproduce aquí, también por AirPlay. No en un Chromecast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Façonne le son de tout ce qui est lu ici, y compris via AirPlay. Pas sur un Chromecast."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modella il suono di tutto ciò che viene riprodotto qui, anche su AirPlay. Non su un Chromecast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで再生するすべての音を調整します（AirPlayを含む）。Chromecastでは使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay를 포함해 여기서 재생되는 모든 소리를 조정합니다. Chromecast에서는 적용되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vormt het geluid van alles wat hier speelt, ook via AirPlay. Niet op een Chromecast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta o som de tudo o que toca aqui, inclusive no AirPlay. Não no Chromecast."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настраивает звук всего, что играет здесь, в том числе через AirPlay. Не на Chromecast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整在此播放的所有声音，包括通过 AirPlay 播放的内容。不适用于 Chromecast。"
          }
        }
      }
    },
