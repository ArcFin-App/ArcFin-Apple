    "Press and hold the clickpad to play at this speed until you let go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte das Clickpad gedrückt, um mit diesem Tempo abzuspielen, bis du loslässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén pulsado el clickpad para reproducir a esta velocidad hasta que lo sueltes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maintenez le pavé tactile enfoncé pour lire à cette vitesse jusqu’à ce que vous le relâchiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuto il clickpad per riprodurre a questa velocità finché non lo rilasci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "クリックパッドを押し続けると、離すまでこの速度で再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "클릭패드를 길게 누르면 뗄 때까지 이 속도로 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd het klikvlak ingedrukt om op deze snelheid af te spelen tot je loslaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pressione e segure o clickpad para reproduzir nesta velocidade até soltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удерживайте сенсорную панель нажатой, чтобы воспроизводить с этой скоростью, пока не отпустите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
