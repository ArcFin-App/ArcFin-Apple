    "The speed new videos start at." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Geschwindigkeit, mit der neue Videos starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
