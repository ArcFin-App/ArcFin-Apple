    "Only for audio always going to a receiver over AirPlay or HDMI. This device can't play these itself, so they'd be silent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur für Audio, das immer über AirPlay oder HDMI an einen Receiver geht. Dieses Gerät kann diese Formate selbst nicht abspielen, sie wären also stumm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo para audio que siempre va a un receptor por AirPlay o HDMI. Este dispositivo no puede reproducirlos por sí mismo, así que no sonarían."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uniquement pour un son toujours envoyé à un ampli via AirPlay ou HDMI. Cet appareil ne peut pas les lire lui-même, ils seraient donc muets."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo per l’audio inviato sempre a un ricevitore tramite AirPlay o HDMI. Questo dispositivo non può riprodurli da solo, quindi sarebbero muti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AirPlayやHDMIで常にAVレシーバーに送るオーディオの場合のみ。このデバイス自体ではこれらを再生できないため、音が出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AirPlay나 HDMI를 통해 항상 리시버로 보내는 오디오에만 사용하세요. 이 기기는 이 포맷을 직접 재생할 수 없으므로 소리가 나지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alleen voor audio die altijd via AirPlay of HDMI naar een receiver gaat. Dit apparaat kan deze formaten zelf niet afspelen, dus ze zouden stil zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Somente para áudio sempre enviado a um receiver por AirPlay ou HDMI. Este dispositivo não consegue reproduzir esses formatos sozinho, então ficariam mudos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Только для звука, который всегда идёт на ресивер через AirPlay или HDMI. Это устройство само не может воспроизвести эти форматы, поэтому звука не будет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅适用于始终通过隔空播放或 HDMI 发送到功放的音频。此设备本身无法播放这些格式，因此会没有声音。"
          }
        }
      }
    },
