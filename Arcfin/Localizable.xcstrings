    "Every detail and image is fetched again, and edits made by hand are lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle Details und Bilder werden neu geladen, und manuelle Änderungen gehen verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se vuelven a obtener todos los detalles e imágenes, y se pierden los cambios hechos a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toutes les informations et images sont récupérées à nouveau, et les modifications manuelles sont perdues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutti i dettagli e le immagini vengono recuperati di nuovo e le modifiche manuali vanno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "すべての情報と画像を取得し直すため、手動で編集した内容は失われます。"
          }
        },
        "ko" : {
