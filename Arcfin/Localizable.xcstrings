          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La vitesse de départ des nouvelles vidéos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A velocidade em que novos vídeos começam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "新视频的起始速度。"
          }
        }
      }
    },
    "The tab Arcfin opens on. Discover and Watchlist need Seerr; without it, Home." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Tab, mit dem Arcfin öffnet. Entdecken und Merkliste brauchen Seerr; ohne Seerr die Startseite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La pestaña con la que se abre Arcfin. Descubrir y Lista necesitan Seerr; sin él, Inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’onglet sur lequel Arcfin s’ouvre. Découvrir et Liste de suivi nécessitent Seerr ; sinon, Accueil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A aba em que o Arcfin abre. Descobrir e Lista precisam do Seerr; sem ele, Início."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arcfin 启动时打开的标签页。“发现”和“待看列表”需要 Seerr；没有 Seerr 时为首页。"
          }
        }
      }
    },
    "The thumbnails shown while you scrub. Leaving them out saves space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Vorschaubilder beim Spulen. Ohne sie wird Speicher gespart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las miniaturas que se muestran al desplazarte. No incluirlas ahorra espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les vignettes affichées pendant le défilement. Les exclure économise de l’espace."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As miniaturas mostradas enquanto você avança. Deixá-las de fora economiza espaço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拖动时显示的缩略图。不保留可节省空间。"
          }
        }
      }
    },
    "The titles stay in your library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Titel bleiben in deiner Mediathek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los títulos se quedan en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les titres restent dans votre bibliothèque."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
