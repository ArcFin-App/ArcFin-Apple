    "Put Arcfin in the top row of your Apple TV to see what you're watching, with logos and progress, plus Next Up." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Arcfin in die oberste Reihe deines Apple TV, um zu sehen, was du gerade schaust, mit Logos und Fortschritt, dazu Als Nächstes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon Arcfin en la fila superior de tu Apple TV para ver lo que estás viendo, con logotipos y progreso, además de A continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez Arcfin dans la rangée du haut de votre Apple TV pour voir ce que vous regardez, avec logos et progression, ainsi que la suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti Arcfin nella fila in alto della tua Apple TV per vedere cosa stai guardando, con loghi e avanzamento, più A seguire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV の一番上の列に Arcfin を置くと、視聴中の作品がロゴや進行状況とともに表示され、「次に再生」も並びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV의 맨 위 줄에 Arcfin을 두면 시청 중인 콘텐츠가 로고와 진행 상황과 함께 표시되고, 다음 항목도 볼 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Arcfin in de bovenste rij van je Apple TV om te zien wat je kijkt, met logo's en voortgang, plus Hierna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o Arcfin na fileira de cima da sua Apple TV para ver o que você está assistindo, com logos e progresso, além de A seguir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поместите Arcfin в верхний ряд Apple TV, чтобы видеть, что вы смотрите, с логотипами и прогрессом, а также следующее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 Arcfin 放到 Apple TV 的最上面一行，就能看到你正在看的内容，附带标志和进度，还有接下来要看的。"
          }
        }
      }
    },
    "Puts it in Home's hero for everyone on this server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeigt den Titel für alle auf diesem Server oben auf der Startseite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo pone en la cabecera de Inicio para todos en este servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le place dans la bannière de l'accueil pour tous les utilisateurs de ce serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo mette nel banner della Home per tutti su questo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このサーバーの全員のホーム上部に表示します。"
          }
        },
        "ko" : {
