        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연결은 HD 비디오에 느립니다. 서버가 비디오를 낮은 화질로 변환할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze verbinding is traag voor HD-video. De server zet video waarschijnlijk om naar lagere kwaliteit."
