        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les vignettes affichées pendant le défilement. Les exclure économise de l’espace."
          }
        }
      }
    },
    "The titles stay in your library." : {
      "localizations" : {
