    "Turn off if HEVC videos stall or stay black on this device; they'll be converted to H.264 instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ausschalten, wenn HEVC-Videos auf diesem Gerät hängen oder schwarz bleiben; sie werden dann stattdessen in H.264 umgewandelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desactívalo si los vídeos HEVC se atascan o se quedan en negro en este dispositivo; se convertirán a H.264."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désactivez si les vidéos HEVC se figent ou restent noires sur cet appareil ; elles seront converties en H.264 à la place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Disattiva se i video HEVC si bloccano o restano neri su questo dispositivo; verranno invece convertiti in H.264."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このデバイスでHEVCビデオが止まったり黒いままになったりする場合はオフにしてください。代わりにH.264に変換されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 기기에서 HEVC 비디오가 멈추거나 검게 표시되면 끄세요. 대신 H.264로 변환됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zet uit als HEVC-video’s op dit apparaat haperen of zwart blijven; ze worden dan geconverteerd naar H.264."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desative se vídeos HEVC travarem ou ficarem pretos neste dispositivo; eles serão convertidos para H.264."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выключите, если видео HEVC зависают или остаются чёрными на этом устройстве; вместо этого они будут преобразованы в H.264."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "如果 HEVC 视频在此设备上卡住或黑屏，请关闭此项；它们将改为转换成 H.264。"
          }
        }
      }
    },
