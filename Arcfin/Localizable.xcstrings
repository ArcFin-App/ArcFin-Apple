      }
    },
    "These need the Aether player engine, which Auto uses for most videos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese brauchen die Player-Engine Aether, die „Automatisch“ für die meisten Videos verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Necesitan el motor de reproducción Aether, que Automático usa para la mayoría de los vídeos."
