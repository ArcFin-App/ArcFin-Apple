        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscimento dei brani in “Cosa sta suonando?” è fornito da Shazam."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「この曲は？」の曲の認識はShazamによって提供されています。"
