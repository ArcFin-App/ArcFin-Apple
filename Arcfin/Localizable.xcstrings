    "Tick the rows to show, and drag them into the order you like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hake die Zeilen an, die angezeigt werden sollen, und zieh sie in die gewünschte Reihenfolge."
          }
        },
        "es" : {
          "stringUnit" : {
