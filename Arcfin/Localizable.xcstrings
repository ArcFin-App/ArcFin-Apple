    "spotify.com › Account › Privacy settings › Download your data: Extended streaming history. Pick the Streaming_History_Audio files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › Konto › Datenschutzeinstellungen › Daten herunterladen: Erweiterter Streamingverlauf. Wähle die Streaming_History_Audio-Dateien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › Cuenta › Configuración de privacidad › Descarga tus datos: Historial de reproducción ampliado. Elige los archivos Streaming_History_Audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › Compte › Paramètres de confidentialité › Télécharger vos données : historique de streaming étendu. Choisissez les fichiers Streaming_History_Audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › Account › Impostazioni privacy › Scarica i tuoi dati: cronologia di streaming estesa. Scegli i file Streaming_History_Audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › アカウント › プライバシー設定 › データをダウンロード：拡張ストリーミング履歴。Streaming_History_Audio ファイルを選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › 계정 › 개인정보 설정 › 데이터 다운로드: 확장 스트리밍 기록. Streaming_History_Audio 파일을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › Account › Privacyinstellingen › Je gegevens downloaden: uitgebreide streamgeschiedenis. Kies de Streaming_History_Audio-bestanden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › Conta › Configurações de privacidade › Baixar seus dados: histórico de streaming estendido. Escolha os arquivos Streaming_History_Audio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › Аккаунт › Настройки конфиденциальности › Скачать данные: расширенная история прослушивания. Выберите файлы Streaming_History_Audio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "spotify.com › 账户 › 隐私设置 › 下载你的数据：扩展流媒体历史记录。选择 Streaming_History_Audio 文件。"
          }
        }
      }
    },
