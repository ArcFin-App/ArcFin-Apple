        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arcfin의 알림이 꺼져 있습니다. 이 알림을 받으려면 시스템 설정에서 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen staan uit voor Arcfin. Zet ze aan in Systeeminstellingen om deze te krijgen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desativadas para o Arcfin. Ative-as em Ajustes do Sistema para receber estas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления для Arcfin выключены. Включите их в Системных настройках, чтобы получать эти уведомления."
          }
