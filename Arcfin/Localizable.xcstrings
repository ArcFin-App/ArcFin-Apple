          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Com um PIN, o Arcfin o pede ao abrir e antes de mudar para este perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "С PIN-кодом Arcfin запрашивает его при открытии и перед переключением на этот профиль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
