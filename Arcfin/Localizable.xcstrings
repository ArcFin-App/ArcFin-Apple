    "Glide across the Siri Remote's touch surface to move freely through a movie or episode, then click to jump there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Streiche über die Touch-Oberfläche der Siri Remote, um frei durch einen Film oder eine Folge zu spulen, und klicke, um dorthin zu springen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desliza por la superficie táctil del Siri Remote para moverte libremente por una película o episodio y haz clic para ir allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Glissez sur la surface tactile de la Siri Remote pour vous déplacer librement dans un film ou un épisode, puis cliquez pour y aller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scorri sulla superficie touch del Siri Remote per muoverti liberamente in un film o episodio, poi fai clic per andarci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siri Remoteのタッチサーフェスをなぞって映画やエピソードを自由に移動し、クリックしてその位置へ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siri Remote의 터치 표면을 쓸어 영화나 에피소드를 자유롭게 이동한 다음 클릭하여 그 위치로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Veeg over het aanraakoppervlak van de Siri Remote om vrij door een film of aflevering te gaan en klik om erheen te springen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deslize na superfície de toque do Siri Remote para percorrer livremente um filme ou episódio e clique para ir até lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Проводите по сенсорной поверхности Siri Remote, чтобы свободно перемещаться по фильму или серии, и нажмите, чтобы перейти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在 Siri Remote 的触控表面上滑动，即可在电影或剧集中自由移动，然后按下即可跳转。"
          }
        }
      }
    },
