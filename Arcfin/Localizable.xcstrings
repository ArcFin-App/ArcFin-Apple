    "Hold the right arrow key to play at this speed until you let go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte die Rechtspfeiltaste gedrückt, um mit diesem Tempo abzuspielen, bis du loslässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén pulsada la tecla de flecha derecha para reproducir a esta velocidad hasta que la sueltes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maintenez la flèche droite pour lire à cette vitesse jusqu’à ce que vous la relâchiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuto il tasto freccia destra per riprodurre a questa velocità finché non lo rilasci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "右矢印キーを押し続けると、離すまでこの速度で再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "오른쪽 화살표 키를 누르고 있으면 뗄 때까지 이 속도로 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Houd de pijl-naar-rechtstoets ingedrukt om op deze snelheid af te spelen tot je loslaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha a seta para a direita pressionada para reproduzir nesta velocidade até soltar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удерживайте клавишу со стрелкой вправо, чтобы воспроизводить с этой скоростью, пока не отпустите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "按住右方向键即可以此速度播放，松开后恢复。"
          }
        }
      }
    },
