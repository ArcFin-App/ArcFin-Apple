    "Measures this connection to your server, the way the player does before a video starts. Wi-Fi and mobile data can differ." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst diese Verbindung zu deinem Server so, wie es der Player vor einem Video tut. WLAN und mobile Daten können sich unterscheiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide esta conexión con tu servidor, como lo hace el reproductor antes de empezar un vídeo. El wifi y los datos móviles pueden diferir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure cette connexion à votre serveur, comme le fait le lecteur avant une vidéo. Le Wi-Fi et les données cellulaires peuvent différer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura questa connessione al server, come fa il player prima di avviare un video. Wi-Fi e dati cellulare possono essere diversi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーがビデオ開始前に行うのと同じ方法で、サーバへの接続を測定します。Wi-Fiとモバイルデータでは異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플레이어가 비디오 시작 전에 하는 것처럼 서버 연결을 측정합니다. Wi-Fi와 모바일 데이터는 다를 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meet deze verbinding met je server, zoals de speler doet voordat een video start. Wifi en mobiele data kunnen verschillen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mede esta conexão com o servidor, como o player faz antes de um vídeo começar. Wi-Fi e dados móveis podem ser diferentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измеряет подключение к серверу так же, как плеер перед началом видео. Wi-Fi и мобильная сеть могут отличаться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "像播放器在视频开始前那样测量到服务器的连接。无线局域网和蜂窝数据可能不同。"
          }
        }
      }
    },
