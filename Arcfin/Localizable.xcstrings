    "Past the limit, the songs you play least are removed first. Favorites stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über dem Limit werden zuerst die am wenigsten gespielten Titel entfernt. Favoriten bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al superar el límite, se eliminan primero las canciones que menos escuchas. Las favoritas se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-delà de la limite, les morceaux les moins écoutés sont supprimés en premier. Les favoris restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre il limite, vengono rimossi prima i brani ascoltati meno. I preferiti restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上限を超えると、再生回数の少ない曲から削除されます。お気に入りは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도를 넘으면 가장 적게 재생한 노래부터 삭제됩니다. 즐겨찾기는 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boven de limiet worden de minst gespeelde nummers eerst verwijderd. Favorieten blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acima do limite, as músicas menos tocadas são removidas primeiro. As favoritas ficam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При превышении лимита сначала удаляются реже всего прослушиваемые песни. Избранное остаётся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过上限时，会先移除播放最少的歌曲。收藏的歌曲会保留。"
          }
        }
      }
    },
