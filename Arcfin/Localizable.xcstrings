        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este canal não enviou vídeo. A fonte pode estar fora do ar. Tente novamente ou escolha outro canal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Канал не передал видео. Возможно, источник недоступен. Попробуйте снова или выберите другой канал."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此频道没有传来视频，其信号源可能已离线。请重试或选择其他频道。"
          }
        }
      }
    },
    "This channel isn't on your server any more. Pull down on the channel list to refresh it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Sender ist nicht mehr auf deinem Server. Ziehe die Senderliste nach unten, um sie zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este canal ya no está en tu servidor. Desliza hacia abajo la lista de canales para actualizarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
