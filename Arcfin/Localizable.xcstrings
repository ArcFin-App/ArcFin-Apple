    "Seerr admins can approve or decline requests from the request's page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr-Admins können Anfragen direkt auf der Seite der Anfrage genehmigen oder ablehnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los administradores de Seerr pueden aprobar o rechazar solicitudes desde la página de cada solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les administrateurs Seerr peuvent approuver ou refuser une demande depuis sa page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli amministratori di Seerr possono approvare o rifiutare le richieste dalla pagina della richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr の管理者は、リクエストのページから承認または却下できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr 관리자는 요청 페이지에서 바로 요청을 승인하거나 거절할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr-beheerders kunnen aanvragen goedkeuren of afwijzen vanaf de pagina van de aanvraag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administradores do Seerr podem aprovar ou recusar solicitações na página de cada solicitação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администраторы Seerr могут одобрять или отклонять запросы прямо на странице запроса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr 管理员可以在请求页面直接批准或拒绝请求。"
          }
        }
      }
    },
    "Seerr didn't accept the sign-in. Try again, or check Settings › Plugins › Seerr." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr hat die Anmeldung nicht angenommen. Versuche es erneut oder prüfe Einstellungen › Plugins › Seerr."
          }
