    "Drag to reorder. Up to %lld tabs can be active at once — the rest stay hidden but keep their place in the order if you turn them back on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zum Sortieren ziehen. Bis zu %lld Tabs können gleichzeitig aktiv sein – die übrigen bleiben verborgen, behalten aber ihren Platz, wenn du sie wieder einschaltest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrastra para reordenar. Puede haber hasta %lld pestañas activas a la vez; el resto quedan ocultas pero conservan su lugar si las vuelves a activar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites glisser pour réorganiser. Jusqu’à %lld onglets peuvent être actifs à la fois — les autres restent masqués mais gardent leur place si vous les réactivez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arraste para reordenar. Até %lld abas podem estar ativas ao mesmo tempo — as outras ficam ocultas, mas mantêm seu lugar na ordem se você ativá-las de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "拖动以重新排序。最多可同时启用 %lld 个标签页——其余的会隐藏，但重新打开时会保留其位置。"
          }
        }
      }
    },
