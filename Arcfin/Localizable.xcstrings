    "Watch your server's channels, browse the guide, and set recordings from a programme's details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau die Sender deines Servers, stöbere im Programm und plane Aufnahmen direkt in den Details einer Sendung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira los canales de tu servidor, explora la guía y programa grabaciones desde los detalles de un programa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez les chaînes de votre serveur, parcourez le guide et programmez des enregistrements depuis la fiche d’un programme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda i canali del tuo server, sfoglia la guida e programma le registrazioni dai dettagli di un programma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバのチャンネルを視聴したり、番組表を見たり、番組の詳細から録画を予約したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 채널을 시청하고, 편성표를 둘러보고, 프로그램 상세 정보에서 녹화를 예약하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk naar de zenders van je server, blader door de gids en plan opnames vanuit de details van een programma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assista aos canais do seu servidor, navegue pelo guia e agende gravações nos detalhes de um programa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите каналы своего сервера, листайте телегид и ставьте записи прямо из описания передачи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
