    "Turns subtitles on while the sound is all the way down, and off again when it comes back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schaltet Untertitel ein, solange der Ton ganz leise gestellt ist, und wieder aus, wenn er zurückkommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activa los subtítulos mientras el volumen está al mínimo y los desactiva cuando vuelve el sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Active les sous-titres quand le son est au minimum, et les désactive quand il revient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Attiva i sottotitoli quando il volume è al minimo e li disattiva quando torna l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "音量が最小の間は字幕をオンにし、音が戻るとオフにします。"
