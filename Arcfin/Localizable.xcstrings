        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha “Ignorar nos downloads inteligentes” no menu de um filme ou série, ou nele em Downloads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите «Не включать в умные загрузки» в меню фильма или сериала либо на нём в «Загрузках»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在电影或节目的菜单中，或在“下载”中对其选择“在智能下载中忽略”。"
          }
        }
      }
    },
    "Choose Keep Downloaded in a show's menu to keep its next episodes downloaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wähle „Heruntergeladen behalten“ im Menü einer Serie, damit ihre nächsten Folgen heruntergeladen bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige «Mantener descargado» en el menú de una serie para tener descargados sus próximos episodios."
          }
        },
        "fr" : {
          "stringUnit" : {
