    "Send a request to your Seerr server. You'll be notified when it becomes available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sende eine Anfrage an deinen Seerr-Server. Du wirst benachrichtigt, sobald sie verfügbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envía una solicitud a tu servidor Seerr. Recibirás un aviso cuando esté disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envoyez une demande à votre serveur Seerr. Vous serez averti quand le titre sera disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Invia una richiesta al tuo server Seerr. Riceverai una notifica quando sarà disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerrサーバにリクエストを送信します。視聴可能になると通知が届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seerr 서버에 요청을 보냅니다. 시청할 수 있게 되면 알림을 받습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stuur een aanvraag naar je Seerr-server. Je krijgt een melding zodra het beschikbaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envie uma solicitação ao seu servidor Seerr. Você será avisado quando estiver disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отправьте запрос на сервер Seerr. Вы получите уведомление, когда тайтл станет доступен."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "向你的 Seerr 服务器发送请求。可用时你会收到通知。"
          }
        }
      }
    },
