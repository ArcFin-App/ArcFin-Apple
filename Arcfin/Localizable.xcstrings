    "Type a Quick Connect code right under Your Profile in Settings to sign another device in with your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen Quick-Connect-Code direkt unter Dein Profil in den Einstellungen ein, um ein anderes Gerät mit deinem Konto anzumelden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un código de Quick Connect justo debajo de Tu perfil en Ajustes para iniciar sesión con tu cuenta en otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un code Quick Connect juste sous Votre profil dans les Réglages pour connecter un autre appareil à votre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un codice Quick Connect subito sotto Il tuo profilo nelle Impostazioni per accedere con il tuo account su un altro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」の「あなたのプロフィール」のすぐ下に Quick Connect コードを入力すると、別のデバイスにあなたのアカウントでサインインできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정의 내 프로필 바로 아래에 Quick Connect 코드를 입력하면 다른 기기에서 내 계정으로 로그인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ een Quick Connect-code direct onder Je profiel in Instellingen om een ander apparaat met je account aan te melden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um código do Quick Connect logo abaixo de Seu perfil nos Ajustes para entrar com sua conta em outro dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите код Quick Connect прямо под пунктом «Ваш профиль» в настройках, чтобы войти в свою учётную запись на другом устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中“你的个人资料”下方直接输入 Quick Connect 代码，即可用你的账户登录另一台设备。"
          }
        }
      }
    },
    "Type a Quick Connect code under your profile in Settings › General to sign another device in with your account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen Quick-Connect-Code unter deinem Profil in Einstellungen › Allgemein ein, um ein anderes Gerät mit deinem Konto anzumelden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un código de Quick Connect debajo de tu perfil en Ajustes › General para iniciar sesión con tu cuenta en otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un code Quick Connect sous votre profil dans Réglages › Général pour connecter un autre appareil à votre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
