    "“%@” isn't waiting for approval any more. The list now shows where it stands." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%@“ wartet nicht mehr auf Genehmigung. Die Liste zeigt jetzt den aktuellen Stand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» ya no está pendiente de aprobación. La lista muestra ahora su estado actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« %@ » n’attend plus d’approbation. La liste indique maintenant où en est la demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@” non è più in attesa di approvazione. L’elenco ora ne mostra lo stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「%@」は承認待ちではなくなりました。現在の状況がリストに表示されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘%@’은(는) 더 이상 승인 대기 중이 아닙니다. 목록에 현재 상태가 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘%@’ wacht niet meer op goedkeuring. De lijst laat nu zien hoe het ervoor staat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@” não está mais aguardando aprovação. A lista agora mostra a situação atual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«%@» больше не ждёт одобрения. В списке теперь показано его текущее состояние."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@”已不再等待批准。列表现在会显示其当前状态。"
          }
        }
      }
    },
