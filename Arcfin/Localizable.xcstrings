          }
        }
      }
    },
    "Shows set to Keep Downloaded from their page download straight away, outside the storage budget, and stop under 2 GB free. Swipe to stop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Serien, die auf ihrer Seite auf „Heruntergeladen behalten“ stehen, laden sofort, außerhalb des Speicherbudgets, und stoppen unter 2 GB freiem Speicher. Zum Stoppen wischen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las series marcadas como Mantener descargado en su página se descargan enseguida, fuera del presupuesto de almacenamiento, y se detienen con menos de 2 GB libres. Desliza para detener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les séries réglées sur Garder téléchargé depuis leur page se téléchargent immédiatement, hors budget de stockage, et s’arrêtent sous 2 Go libres. Balayez pour arrêter."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Séries definidas como Manter baixado na página delas baixam na hora, fora do limite de armazenamento, e param com menos de 2 GB livres. Deslize para parar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在其页面上设为“保持下载”的剧集会立即下载，不计入存储空间预算，在剩余空间不足 2 GB 时停止。轻扫以停止。"
          }
        }
      }
    },
