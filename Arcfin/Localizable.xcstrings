    "New order each time you open Home; Continue Watching and Next Up stay on top. Turns off reordering." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neue Reihenfolge bei jedem Öffnen der Startseite; „Weiterschauen“ und „Als Nächstes“ bleiben oben. Schaltet das Sortieren aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nuevo orden cada vez que abres el inicio; Seguir viendo y A continuación se quedan arriba. Desactiva el reordenado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nouvel ordre à chaque ouverture de l’accueil ; Reprendre et À suivre restent en haut. Désactive la réorganisation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nova ordem cada vez que você abre o Início; Continuar assistindo e A seguir ficam no topo. Desativa a reordenação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每次打开首页时都使用新顺序；“继续观看”和“接下来”保持在顶部。会关闭重新排序。"
          }
        }
      }
