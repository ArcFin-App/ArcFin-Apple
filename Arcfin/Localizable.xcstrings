    "A Fuller Discover" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr zu entdecken"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Descubrir más completo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une page Découvrir plus riche"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sezione Scopri più ricca"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "充実した「見つける」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 풍성해진 둘러보기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vollere Ontdekken-pagina"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Descobrir mais completo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновлённый раздел «Обзор»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更丰富的“发现”"
          }
        }
      }
    },
    "Discover mixes big cards with rows of what's trending, titles like your last watch, what's popular on your streaming services, genres and what's coming soon. Titles you've already requested now say so." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entdecken mischt große Karten mit Reihen: Trends, Titel wie dein zuletzt gesehener, Beliebtes bei deinen Streamingdiensten, Genres und Demnächst. Titel, die du schon angefragt hast, zeigen das jetzt an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubrir combina tarjetas grandes con filas de tendencias, títulos parecidos a lo último que viste, lo más popular en tus servicios de streaming, géneros y próximos estrenos. Los títulos que ya pediste ahora lo indican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrir mêle de grandes cartes à des rangées : tendances, titres proches de votre dernier visionnage, succès sur vos services de streaming, genres et prochaines sorties. Les titres déjà demandés l'indiquent désormais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri alterna schede grandi a righe di tendenze, titoli simili all'ultimo che hai visto, i più popolari sui tuoi servizi di streaming, generi e prossime uscite. I titoli che hai già richiesto ora lo indicano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「見つける」では、大きなカードと、トレンド、最近観た作品に似たタイトル、利用中の配信サービスで人気の作品、ジャンル、近日公開の作品の列が並びます。リクエスト済みのタイトルにはその旨が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘러보기에서 큰 카드와 함께 인기 콘텐츠, 최근에 본 작품과 비슷한 타이틀, 내 스트리밍 서비스의 인기작, 장르, 공개 예정작 줄을 볼 수 있습니다. 이미 요청한 타이틀에는 요청됨이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontdekken wisselt grote kaarten af met rijen: trending, titels zoals je laatst bekeken, populair bij je streamingdiensten, genres en binnenkort. Titels die je al hebt aangevraagd laten dat nu zien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Descobrir mistura cartões grandes com fileiras de tendências, títulos parecidos com o que você viu por último, os populares nos seus serviços de streaming, gêneros e lançamentos em breve. Os títulos que você já pediu agora mostram isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Обзор» сочетает большие карточки с подборками: в тренде, похожее на последнее просмотренное, популярное в ваших стриминговых сервисах, жанры и скоро. Уже запрошенные тайтлы теперь отмечены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“发现”将大卡片与多行内容结合：热门趋势、与你上次观看相似的作品、你的流媒体服务上的热门内容、类型和即将上线。你已请求过的作品现在会标明。"
          }
        }
      }
    },
    "Settings › Your Profile shows your account, the libraries you can see, parental controls and what you're allowed to do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen › Dein Profil zeigt dein Konto, die Mediatheken, die du sehen kannst, die Kindersicherung und was du darfst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes › Tu perfil muestra tu cuenta, las bibliotecas que puedes ver, el control parental y lo que tienes permitido hacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages › Votre profil affiche votre compte, les bibliothèques que vous voyez, le contrôle parental et ce que vous êtes autorisé à faire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni › Il tuo profilo mostra il tuo account, le librerie che puoi vedere, il controllo genitori e cosa ti è consentito fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」›「あなたのプロフィール」で、アカウント、表示できるライブラリ、ペアレンタルコントロール、許可されている操作を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › 내 프로필에서 계정, 볼 수 있는 보관함, 자녀 보호 기능, 허용된 작업을 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen › Je profiel toont je account, de bibliotheken die je kunt zien, ouderlijk toezicht en wat je mag doen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes › Seu perfil mostra sua conta, as bibliotecas que você pode ver, o controle parental e o que você tem permissão para fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В разделе «Настройки» › «Ваш профиль» видны ваша учётная запись, доступные медиатеки, родительский контроль и ваши права."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“设置”›“你的个人资料”会显示你的账户、你能看到的资料库、家长控制以及你被允许执行的操作。"
          }
        }
      }
    },
