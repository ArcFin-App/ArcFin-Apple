    "Your sign-in to this server has ended, usually because the password changed or this device was removed from the server. Sign in again to carry on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deine Anmeldung bei diesem Server ist abgelaufen, meist weil das Passwort geändert oder dieses Gerät vom Server entfernt wurde. Melde dich erneut an, um weiterzumachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu sesión en este servidor ha terminado, normalmente porque cambió la contraseña o se eliminó este dispositivo del servidor. Vuelve a iniciar sesión para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre connexion à ce serveur a pris fin, généralement parce que le mot de passe a changé ou que cet appareil a été retiré du serveur. Reconnectez-vous pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
