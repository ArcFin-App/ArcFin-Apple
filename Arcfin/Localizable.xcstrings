    "Up or down on the left for brightness, the right for volume; sideways to move through the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Links nach oben oder unten für Helligkeit, rechts für Lautstärke; seitwärts zum Spulen im Video."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arriba o abajo a la izquierda para el brillo, a la derecha para el volumen; de lado para moverte por el vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haut ou bas à gauche pour la luminosité, à droite pour le volume ; sur les côtés pour avancer dans la vidéo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Su o giù a sinistra per la luminosità, a destra per il volume; di lato per muoverti nel video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "左側の上下で明るさ、右側で音量。左右でビデオ内を移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "왼쪽에서 위아래로 밝기, 오른쪽에서 음량을 조절하고, 옆으로 쓸어 비디오를 탐색합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Omhoog of omlaag aan de linkerkant voor helderheid, rechts voor volume; zijwaarts om door de video te bewegen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para cima ou para baixo à esquerda para brilho, à direita para volume; para os lados para se mover no vídeo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вверх или вниз слева — яркость, справа — громкость; в стороны — перемотка видео."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "左侧上下调节亮度，右侧上下调节音量；左右滑动可在视频中移动。"
          }
        }
      }
    },
