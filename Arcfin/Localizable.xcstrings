    "This also removes its downloads from Arcfin on this device. Keep them to still watch them offline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dabei werden auch die Downloads davon aus Arcfin auf diesem Gerät entfernt. Behalte sie, um sie weiter offline zu schauen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "También elimina sus descargas de Arcfin en este dispositivo. Consérvalas para seguir viéndolas sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cela supprime aussi ses téléchargements d'Arcfin sur cet appareil. Gardez-les pour continuer à les regarder hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rimuove anche i suoi download da Arcfin su questo dispositivo. Mantienili per guardarli ancora offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "このデバイスのArcfinにあるダウンロードも削除されます。オフラインで見たい場合は残してください。"
