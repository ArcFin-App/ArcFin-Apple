    "Posters and backdrops are kept to load faster. Clearing them never touches your downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Poster und Hintergründe werden gespeichert, damit sie schneller laden. Das Leeren betrifft nie deine Downloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los pósteres y fondos se guardan para cargar más rápido. Borrarlos nunca afecta a tus descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
