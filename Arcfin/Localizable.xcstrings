    "New libraries are included automatically only with All Libraries on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neue Mediatheken werden nur mit „Alle Mediatheken“ automatisch einbezogen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las bibliotecas nuevas solo se incluyen automáticamente con Todas las bibliotecas activado."
          }
        },
        "fr" : {
          "stringUnit" : {
