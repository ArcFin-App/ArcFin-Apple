    "Replacing metadata fetches every title's details and artwork again, which can take a long time on a large library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beim Ersetzen werden Details und Bilder aller Titel neu geladen. Bei großen Mediatheken kann das lange dauern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al reemplazar los metadatos se vuelven a obtener los detalles y las imágenes de todos los títulos, lo que puede tardar mucho en una biblioteca grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remplacer les métadonnées récupère à nouveau les informations et images de chaque titre, ce qui peut être long sur une grande médiathèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sostituire i metadati recupera di nuovo dettagli e immagini di ogni titolo, il che può richiedere molto tempo in una libreria grande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "メタデータを置き換えると全タイトルの情報と画像を取得し直すため、大きなライブラリでは時間がかかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "메타데이터를 교체하면 모든 항목의 정보와 이미지를 다시 가져오므로 큰 보관함에서는 오래 걸릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Metadata vervangen haalt de gegevens en afbeeldingen van elke titel opnieuw op. Bij een grote bibliotheek kan dat lang duren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Substituir os metadados busca de novo os detalhes e imagens de cada título, o que pode demorar numa biblioteca grande."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сведения и обложки всех позиций загрузятся заново — в большой медиатеке это может занять много времени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "替换元数据会重新获取每个内容的详细信息和图片，大型资料库可能需要很长时间。"
          }
        }
      }
    },
