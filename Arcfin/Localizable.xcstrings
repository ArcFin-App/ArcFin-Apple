        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Permet aux Téléchargements intelligents d’utiliser les données cellulaires. Des frais peuvent s’appliquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Consente ai Download intelligenti di usare i dati cellulare. Potrebbero essere applicati costi."
