        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Главная открывается на избранном тайтле с трейлером, а кнопки «Вверх» и «Вниз» переключают ряды по одному."
          }
        },
        "zh-Hans" : {
